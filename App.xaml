            <SolidColorBrush x:Key="HeroGradientStartBrush" Color="#1E4F7A"/>
            <SolidColorBrush x:Key="HeroGradientEndBrush" Color="#18649C"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
