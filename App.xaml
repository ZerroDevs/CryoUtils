            <SolidColorBrush x:Key="AccentButtonTextBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SearchMatchBrush" Color="#6FB8F2"/>

            <SolidColorBrush x:Key="CaptureAccentBrush" Color="#4FC3F7"/>
