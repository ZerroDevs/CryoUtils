<Window x:Class="CryoUtils.Views.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CryoUtils.Views"
        Title="{DynamicResource Clip_Title}"
        Width="660" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Images/CryoUtils.ico"
        FontFamily="{StaticResource SegoeUIVariableText}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,40,0">
                        <Image Source="pack://application:,,,/Images/CryoUtils-Icon.png"
                               Width="16" Height="16"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Clip_Title}"
                                   Foreground="{DynamicResource TextTitleBrush}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Clip_HotkeyHint}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="{StaticResource CryoMono}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="10,1,0,0"
                                   FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <Button Style="{StaticResource TitleActionBtn}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Click="BtnClose_Click"
                            ToolTip="{DynamicResource Common_Close}"
                            AutomationProperties.Name="{DynamicResource Common_Close}">
                        <Path Data="{x:Static views:IconData.Close}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,14,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSearch" Style="{StaticResource CryoTextBox}" Height="30" Padding="8,5" TextChanged="TxtSearch_TextChanged" AutomationProperties.Name="{DynamicResource Clip_Search}"/>
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="{DynamicResource Clip_Search}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <ComboBox x:Name="CmbFilter" Grid.Column="1" Width="138" Height="30" Margin="8,0,0,0" Style="{StaticResource CryoComboBox}" SelectionChanged="CmbFilter_SelectionChanged" AutomationProperties.Name="{DynamicResource Clip_Filter}">
                        <ComboBoxItem Content="{DynamicResource Clip_FilterAll}" Tag="All" IsSelected="True"/>
                        <ComboBoxItem Content="{DynamicResource Clip_FilterText}" Tag="Text"/>
                        <ComboBoxItem Content="{DynamicResource Clip_FilterImage}" Tag="Image"/>
                        <ComboBoxItem Content="{DynamicResource Clip_FilterSnippets}" Tag="Snippets"/>
                        <ComboBoxItem Content="{DynamicResource Clip_FilterPinned}" Tag="Pinned"/>
                    </ComboBox>
                </Grid>

                <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,1" Padding="0,9,0,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Clip_Snippets}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Clip_SnippetHint}" Style="{StaticResource MutedText}" Margin="10,0,0,0" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSnippetName" Style="{StaticResource CryoTextBox}" Height="28" Padding="7,4" AutomationProperties.Name="{DynamicResource Clip_SnippetName}"/>
                            <TextBox x:Name="TxtSnippetText" Grid.Column="1" Style="{StaticResource CryoTextBox}" Height="28" Padding="7,4" Margin="6,0,6,0" AutomationProperties.Name="{DynamicResource Clip_SnippetText}"/>
                            <Button Grid.Column="2" Content="{DynamicResource Clip_AddSnippet}" Style="{StaticResource SecondaryButton}" Height="28" Click="BtnAddSnippet_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ListBox x:Name="ClipList" Style="{StaticResource CryoListView}" MouseDoubleClick="ClipList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DataTemplate.Resources>
                                    <Style TargetType="Path" x:Key="PinPathStyle">
                                        <Setter Property="Stroke" Value="{DynamicResource IconBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="Border" x:Key="PinBadgeStyle">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataTemplate.Resources>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource PinBadgeStyle}" Margin="0,2,6,0" Padding="4,1" CornerRadius="2" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                                    <TextBlock Text="{DynamicResource Clip_Pinned}" Foreground="{DynamicResource AccentTextBrush}" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Button Tag="{Binding}" Click="BtnPinClip_Click" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{DynamicResource Clip_Pin}" AutomationProperties.Name="{DynamicResource Clip_Pin}" Margin="0,0,2,0">
                                                <Path Data="{x:Static views:IconData.Pin}" Style="{StaticResource PinPathStyle}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                                            </Button>
                                            <Button Tag="{Binding}" Click="BtnTransformClip_Click" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{DynamicResource Clip_Transform}" AutomationProperties.Name="{DynamicResource Clip_Transform}" Margin="0,0,2,0">
                                                <Path Data="M3,6 L11,6 M7,6 L7,16 M13,10 L19,10 M16,10 L16,16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                                            </Button>
                                            <Button Tag="{Binding}" Click="BtnOcrClip_Click" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{DynamicResource Clip_Ocr}" AutomationProperties.Name="{DynamicResource Clip_Ocr}" Margin="0,0,2,0">
                                                <Path Data="{x:Static views:CryoIcons.Ocr}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                                            </Button>
                                            <Button Tag="{Binding}" Click="BtnCopyClip_Click" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{DynamicResource Clip_Copy}" AutomationProperties.Name="{DynamicResource Clip_Copy}" Margin="0,0,2,0">
                                                <Path Data="{x:Static views:IconData.Copy}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                                            </Button>
                                            <Button Tag="{Binding}" Click="BtnDeleteClip_Click" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{DynamicResource Clip_Delete}" AutomationProperties.Name="{DynamicResource Clip_Delete}">
                                                <Path Data="M4,5 L16,5 M7,5 L7,17 L13,17 L13,5 M8,3 L12,3" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="{x:Static views:IconData.Clipboard}" Stroke="{DynamicResource ModuleMutedBrush}" StrokeThickness="1.4" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Clip_Empty}" Style="{StaticResource MutedText}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Clip_MemoryOnly}" Style="{StaticResource MutedText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox x:Name="ChkPersistence" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Clip_Persistence}" Checked="Persistence_Changed" Unchecked="Persistence_Changed" Margin="0,0,14,0"/>
                                <TextBlock Text="{DynamicResource Clip_Expiry}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbExpiry" Width="120" Height="26" Style="{StaticResource CryoComboBox}" SelectionChanged="Expiry_Changed" AutomationProperties.Name="{DynamicResource Clip_Expiry}">
                                    <ComboBoxItem Content="{DynamicResource Clip_ExpiryNever}" Tag="0"/>
                                    <ComboBoxItem Content="{DynamicResource Clip_Expiry15}" Tag="15"/>
                                    <ComboBoxItem Content="{DynamicResource Clip_Expiry60}" Tag="60"/>
                                    <ComboBoxItem Content="{DynamicResource Clip_ExpiryDay}" Tag="1440"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="{DynamicResource Clip_Clear}" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnClear_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
