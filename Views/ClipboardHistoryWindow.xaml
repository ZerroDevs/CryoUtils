<Window x:Class="CryoUtils.Views.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CryoUtils.Views"
        Title="{DynamicResource Clip_Title}"
        Width="600" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SegoeUIVariableText}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Clip_Title}" Style="{StaticResource PageTitle}" FontSize="19"/>
                    <TextBlock Text="{DynamicResource Clip_HotkeyHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                </StackPanel>
                <Button Style="{StaticResource TitleActionBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnClose_Click" ToolTip="{DynamicResource Common_Close}" AutomationProperties.Name="{DynamicResource Common_Close}">
                    <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,10">
                <TextBox x:Name="TxtSearch" Style="{StaticResource CryoTextBox}" Height="32" Padding="8,5" TextChanged="TxtSearch_TextChanged" AutomationProperties.Name="{DynamicResource Clip_Search}"/>
                <TextBlock x:Name="TxtSearchPlaceholder" Text="{DynamicResource Clip_Search}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <Grid Grid.Row="2">
                <ListBox x:Name="ClipList" Style="{StaticResource CryoListView}" MouseDoubleClick="ClipList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DataTemplate.Resources>
                                <Style TargetType="Path" x:Key="PinPathStyle">
                                    <Setter Property="Stroke" Value="{DynamicResource IconBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="Border" x:Key="PinBadgeStyle">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataTemplate.Resources>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource PinBadgeStyle}" Margin="0,2,6,0" Padding="4,1" CornerRadius="2" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                                <TextBlock Text="{DynamicResource Clip_Pinned}" Foreground="{DynamicResource AccentTextBrush}" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button Tag="{Binding}" Click="BtnPinClip_Click" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{DynamicResource Clip_Pin}" AutomationProperties.Name="{DynamicResource Clip_Pin}" Margin="0,0,2,0">
                                            <Path Data="{x:Static views:IconData.Pin}" Style="{StaticResource PinPathStyle}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                                        </Button>
                                        <Button Tag="{Binding}" Click="BtnTransformClip_Click" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{DynamicResource Clip_Transform}" AutomationProperties.Name="{DynamicResource Clip_Transform}" Margin="0,0,2,0">
                                            <Path Data="M3,6 L11,6 M7,6 L7,16 M13,10 L19,10 M16,10 L16,16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                                        </Button>
                                        <Button Tag="{Binding}" Click="BtnCopyClip_Click" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{DynamicResource Clip_Copy}" AutomationProperties.Name="{DynamicResource Clip_Copy}" Margin="0,0,2,0">
                                            <Path Data="{x:Static views:IconData.Copy}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                                        </Button>
                                        <Button Tag="{Binding}" Click="BtnDeleteClip_Click" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{DynamicResource Clip_Delete}" AutomationProperties.Name="{DynamicResource Clip_Delete}">
                                            <Path Data="M4,5 L16,5 M7,5 L7,17 L13,17 L13,5 M8,3 L12,3" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="{x:Static views:IconData.Clipboard}" Stroke="{DynamicResource ModuleMutedBrush}" StrokeThickness="1.4" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Clip_Empty}" Style="{StaticResource MutedText}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource Clip_MemoryOnly}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Clip_Clear}" Style="{StaticResource DangerButton}" Click="BtnClear_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
