<Window x:Class="CryoUtils.Views.OperationProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Progress_Title}"
        Width="380" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SegoeUIVariableText}"
        Icon="pack://application:,,,/Images/CryoUtils.ico"
        Closing="Window_Closing">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource Progress_Title}"
                           Foreground="{DynamicResource TextTitleBrush}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="12,0"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="16,12,16,14">
                <TextBlock x:Name="TxtOperation"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="12"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,10"/>

                <ProgressBar x:Name="ProgressBar"
                             Minimum="0" Maximum="100" Value="0"
                             Height="6"
                             Margin="0,0,0,6"
                             Background="{DynamicResource InsetBackgroundBrush}"
                             Foreground="{DynamicResource AccentBrush}"
                             BorderThickness="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"/>
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>

                <TextBlock x:Name="TxtStatus"
                           Style="{StaticResource MutedText}"
                           FontSize="10.5"
                           Margin="0,0,0,12"/>

                <Button x:Name="BtnCancel"
                        Content="{DynamicResource Common_Cancel}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right"
                        MinWidth="84"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>