<Window x:Class="CryoUtils.Views.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Capture_OcrTitle}"
        Width="640"
        SizeToContent="Height"
        MaxHeight="700"
        MinHeight="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="{StaticResource SegoeUIVariableText}">

    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Capture_OcrTitle}" Style="{StaticResource PageTitle}" FontSize="18"/>
                    <TextBlock Text="{DynamicResource Ocr_Subtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0" MaxWidth="500" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtSource" Text="{DynamicResource Ocr_FromSelection}" Style="{StaticResource MutedText}" Margin="0,3,0,0" MaxWidth="500" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Style="{StaticResource TitleActionBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnClose_Click" ToolTip="{DynamicResource Common_Close}" AutomationProperties.Name="{DynamicResource Common_Close}">
                    <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkCodeMode"
                              Style="{StaticResource CryoCheckBox}"
                              Content="{DynamicResource Ocr_CodeMode}"
                              Checked="ChkCodeMode_Changed"
                              Unchecked="ChkCodeMode_Changed"/>
                    <CheckBox x:Name="ChkWrap"
                              Style="{StaticResource CryoCheckBox}"
                              Content="{DynamicResource Ocr_Wrap}"
                              Margin="16,0,0,0"
                              Checked="ChkWrap_Changed"
                              Unchecked="ChkWrap_Changed"/>
                </StackPanel>
                <TextBlock x:Name="TxtMeta"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="{StaticResource CryoMono}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FlowDirection="LeftToRight"/>
            </Grid>

            <TextBox x:Name="TxtResult"
                     Grid.Row="2"
                     Style="{StaticResource CryoTextBox}"
                     Margin="0,0,0,10"
                     Padding="12,10"
                     FontSize="13"
                     MinHeight="72"
                     MaxHeight="360"
                     VerticalContentAlignment="Top"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     SpellCheck.IsEnabled="False"
                     TextChanged="TxtResult_TextChanged"
                     AutomationProperties.Name="{DynamicResource Capture_OcrTitle}"/>

            <Border x:Name="ColorPanel" Grid.Row="3" Style="{StaticResource InsetBorder}" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtColorsLabel" Text="{DynamicResource Ocr_Colors}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                    <WrapPanel x:Name="ColorSwatchesPanel" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="{DynamicResource Common_Open}" Style="{StaticResource SecondaryButton}" Click="BtnOpenFile_Click" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource Common_SaveAs}" Style="{StaticResource SecondaryButton}" Click="BtnSaveFile_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Common_Close}" Style="{StaticResource SecondaryButton}" Click="BtnClose_Click" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource Capture_OcrCopy}" Style="{StaticResource PrimaryButton}" Click="BtnCopy_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
