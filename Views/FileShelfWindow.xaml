<Window x:Class="CryoUtils.Views.FileShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CryoUtils.Views"
        Title="{DynamicResource Shelf_Title}"
        Width="500" Height="440"
        MinWidth="380" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Icon="pack://application:,,,/Images/CryoUtils.ico"
        FontFamily="{StaticResource SegoeUIVariableText}">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,40,0">
                        <Image Source="pack://application:,,,/Images/CryoUtils-Icon.png"
                               Width="16" Height="16"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Shelf_Title}"
                                   Foreground="{DynamicResource TextTitleBrush}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource TitleActionBtn}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Click="BtnClose_Click"
                            ToolTip="{DynamicResource Common_Close}"
                            AutomationProperties.Name="{DynamicResource Common_Close}">
                        <Path Data="{x:Static views:IconData.Close}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,10,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource Shelf_Hint}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>

                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button Content="{DynamicResource Shelf_Add}" Style="{StaticResource SecondaryButton}" Click="BtnAdd_Click" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Shelf_AddFolder}" Style="{StaticResource SecondaryButton}" Click="BtnAddFolder_Click" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Shelf_Remove}" Style="{StaticResource SecondaryButton}" Click="BtnRemove_Click" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Shelf_Clear}" Style="{StaticResource SecondaryButton}" Click="BtnClear_Click"/>
                </WrapPanel>

                <Border Grid.Row="2"
                        Background="{DynamicResource InsetBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        AllowDrop="True"
                        DragOver="Window_DragOver"
                        Drop="Window_Drop">
                    <Grid>
                        <ListBox x:Name="ShelfList"
                                 Style="{StaticResource CryoListView}"
                                 DisplayMemberPath="Display"
                                 SelectionMode="Extended"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 PreviewMouseLeftButtonDown="ShelfList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="ShelfList_PreviewMouseMove"/>
                        <TextBlock x:Name="EmptyHint"
                                   Text="{DynamicResource Shelf_Empty}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStatus"
                               Text="{DynamicResource Shelf_Ready}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Shelf_ConvertTo}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="CmbFormat" Style="{StaticResource CryoComboBox}" Width="86" SelectedIndex="0" Margin="0,0,6,0">
                            <ComboBoxItem Content="PNG" Tag="PNG"/>
                            <ComboBoxItem Content="JPG" Tag="JPG"/>
                            <ComboBoxItem Content="WEBP" Tag="WEBP"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Shelf_Compress}" Style="{StaticResource PrimaryButton}" Click="BtnCompress_Click" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Shelf_Convert}" Style="{StaticResource SecondaryButton}" Click="BtnConvert_Click" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Shelf_MergePdf}" Style="{StaticResource SecondaryButton}" Click="BtnMergePdf_Click" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Shelf_CopyPaths}" Style="{StaticResource SecondaryButton}" Click="BtnCopyPaths_Click"/>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
