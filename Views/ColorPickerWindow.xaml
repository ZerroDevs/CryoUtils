<Window x:Class="CryoUtils.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CryoUtils.Views"
        Title="{DynamicResource Color_Title}"
        Width="352"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SegoeUIVariableText}"
        Icon="pack://application:,,,/Images/CryoUtils.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Draggable Cryo-Family Title Bar -->
            <Grid Grid.Row="0"
                  Background="{DynamicResource TitleBarBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                    <Image Source="pack://application:,,,/Images/CryoUtils-Icon.png"
                           Width="16" Height="16"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,7,0"/>
                    <TextBlock Text="{DynamicResource Color_Title}"
                               Foreground="{DynamicResource TextTitleBrush}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="6,2"
                        CornerRadius="2"
                        Background="{DynamicResource InsetBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,6,0">
                    <TextBlock x:Name="TxtStatusBadge"
                               Text="{DynamicResource Color_PickingStatus}"
                               Foreground="{DynamicResource AccentTextBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>

                <Button Grid.Column="2"
                        Style="{StaticResource TitleActionBtn}"
                        Width="28" Height="28"
                        Margin="0,0,6,0"
                        Click="BtnClose_Click"
                        ToolTip="{DynamicResource Common_Close}"
                        AutomationProperties.Name="{DynamicResource Common_Close}">
                    <Path Data="{x:Static views:IconData.Close}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="14,10,14,14">
                <!-- Magnifier + Coordinates -->
                <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3" Height="148" ClipToBounds="True">
                    <Grid Background="{DynamicResource InsetBackgroundBrush}">
                        <Image x:Name="MagnifierImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Rectangle Width="1" Fill="{DynamicResource OverlaySelectionBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" IsHitTestVisible="False"/>
                        <Rectangle Height="1" Fill="{DynamicResource OverlaySelectionBorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Border Width="13" Height="13" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="6" Padding="6,2" CornerRadius="2" Background="{DynamicResource OverlayBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" IsHitTestVisible="False">
                            <TextBlock x:Name="TxtCoords" Text="0, 0" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="9.5" FlowDirection="LeftToRight"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Action Toolbar: Pick + Copy + Contrast Lock -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnPick"
                            Grid.Column="0"
                            Content="{DynamicResource Color_PickFromScreen}"
                            Style="{StaticResource PrimaryButton}"
                            Height="30"
                            Click="BtnPick_Click"/>
                    <Button x:Name="BtnCopySelected"
                            Grid.Column="2"
                            Content="{DynamicResource Common_Copy}"
                            Style="{StaticResource SecondaryButton}"
                            Height="30"
                            Padding="12,4"
                            Click="BtnCopySelected_Click"/>
                    <Button x:Name="BtnLockContrast"
                            Grid.Column="4"
                            Content="{DynamicResource Color_Contrast}"
                            Style="{StaticResource SecondaryButton}"
                            Height="30"
                            Padding="10,4"
                            Click="BtnLockContrast_Click"
                            ToolTip="{DynamicResource Color_LockBase}"
                            AutomationProperties.Name="{DynamicResource Color_LockBase}"/>
                </Grid>

                <!-- Primary Swatch + Active Value + Format Selector -->
                <Border Margin="0,10,0,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="96"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ColorPreview" Width="36" Height="36" CornerRadius="3" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHex" Text="#000000" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="15.5" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                            <TextBlock Text="{DynamicResource Color_Format}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,1,0,0"/>
                        </StackPanel>

                        <ComboBox x:Name="CmbFormat" Grid.Column="2" Style="{StaticResource CryoComboBox}" Height="28" VerticalAlignment="Center" SelectionChanged="CmbFormat_SelectionChanged" AutomationProperties.Name="{DynamicResource Color_Format}">
                            <ComboBoxItem Content="HEX" Tag="HEX"/>
                            <ComboBoxItem Content="RGB" Tag="RGB"/>
                            <ComboBoxItem Content="HSL" Tag="HSL"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- One-Click Copy Rows for HEX / RGB / HSL -->
                <Border Margin="0,8,0,0" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Color_Hex}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHexRow" Grid.Row="0" Grid.Column="1" Text="#000000" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="11" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="22" Padding="3" Tag="HEX" Click="BtnCopyRow_Click" ToolTip="{DynamicResource Common_Copy}" AutomationProperties.Name="{DynamicResource Color_Hex}">
                            <Path Data="{x:Static views:IconData.Copy}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.35" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Color_Rgb}" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtRgb" Grid.Row="1" Grid.Column="1" Text="rgb(0, 0, 0)" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="11" Margin="0,4,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="22" Padding="3" Margin="0,4,0,0" Tag="RGB" Click="BtnCopyRow_Click" ToolTip="{DynamicResource Common_Copy}" AutomationProperties.Name="{DynamicResource Color_Rgb}">
                            <Path Data="{x:Static views:IconData.Copy}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.35" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Color_Hsl}" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHsl" Grid.Row="2" Grid.Column="1" Text="hsl(0, 0%, 0%)" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="11" Margin="0,4,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="22" Padding="3" Margin="0,4,0,0" Tag="HSL" Click="BtnCopyRow_Click" ToolTip="{DynamicResource Common_Copy}" AutomationProperties.Name="{DynamicResource Color_Hsl}">
                            <Path Data="{x:Static views:IconData.Copy}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.35" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Optional WCAG Contrast Panel -->
                <Border x:Name="ContrastPanel" Margin="0,8,0,0" Height="36" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3" Visibility="Collapsed" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BaseColorSwatch" Width="18" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="vs" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border x:Name="CurrentColorSwatch" Width="18" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtContrastRatio" Grid.Column="1" Text="1.00:1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource CryoMono}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BadgeAa" Padding="5,2" CornerRadius="2" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,4,0">
                                <TextBlock x:Name="TxtBadgeAa" Text="AA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <Border x:Name="BadgeAaa" Padding="5,2" CornerRadius="2" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
                                <TextBlock x:Name="TxtBadgeAaa" Text="AAA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{DynamicResource Color_InteractiveHint}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
