<Window x:Class="CryoUtils.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Color_Title}"
        Width="330" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SegoeUIVariableText}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="{DynamicResource Color_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                <Button Style="{StaticResource TitleActionBtn}" HorizontalAlignment="Right" Width="26" Height="26" Click="BtnClose_Click" ToolTip="{DynamicResource Common_Close}" AutomationProperties.Name="{DynamicResource Common_Close}">
                    <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="0,12,0,0" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3" Height="160" ClipToBounds="True">
                <Grid Background="{DynamicResource InsetBackgroundBrush}">
                    <Image x:Name="MagnifierImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Rectangle Width="1" Fill="{DynamicResource OverlaySelectionBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                    <Rectangle Height="1" Fill="{DynamicResource OverlaySelectionBorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <Ellipse Width="17" Height="17" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Border Height="44" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Border x:Name="ColorPreview" Width="34" Height="28" CornerRadius="2" HorizontalAlignment="Left" Margin="8,0,0,0" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                        <TextBlock x:Name="TxtHex" Text="#000000" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="17" Margin="52,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Color_Rgb}" Style="{StaticResource FieldLabel}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="TxtRgb" Text="rgb(0, 0, 0)" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{DynamicResource Color_Hsl}" Style="{StaticResource FieldLabel}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="TxtHsl" Text="hsl(0, 0%, 0%)" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="104">
                    <TextBlock Text="{DynamicResource Color_Format}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CmbFormat" Style="{StaticResource CryoComboBox}" Height="26" SelectionChanged="CmbFormat_SelectionChanged" AutomationProperties.Name="{DynamicResource Color_Format}">
                        <ComboBoxItem Content="HEX" Tag="HEX"/>
                        <ComboBoxItem Content="RGB" Tag="RGB"/>
                        <ComboBoxItem Content="HSL" Tag="HSL"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border x:Name="ContrastPanel" Grid.Row="4" Margin="0,10,0,0" Height="36" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3" Visibility="Collapsed" Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BaseColorSwatch" Width="18" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="vs" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border x:Name="CurrentColorSwatch" Width="18" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtContrastRatio" Grid.Column="1" Text="1.00:1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource CryoMono}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BadgeAa" Padding="5,2" CornerRadius="2" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,4,0">
                            <TextBlock x:Name="TxtBadgeAa" Text="AA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <Border x:Name="BadgeAaa" Padding="5,2" CornerRadius="2" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
                            <TextBlock x:Name="TxtBadgeAaa" Text="AAA" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="5" Text="{DynamicResource Color_ContrastHint}" Style="{StaticResource MutedText}" Margin="0,10,0,0" VerticalAlignment="Top" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="6" Text="{DynamicResource Color_Magnifier}" Style="{StaticResource MutedText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,4,0,0"/>
        </Grid>
    </Border>
</Window>
