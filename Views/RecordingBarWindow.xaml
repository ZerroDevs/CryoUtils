<Window x:Class="CryoUtils.Views.RecordingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CryoUtils.Views"
        Title="{DynamicResource Rec_Title}"
        Width="900" Height="76"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SegoeUIVariableText}">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource RecordingBorderBrush}"
            BorderThickness="1"
            CornerRadius="2"
            Padding="12,9">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource RecordingBorderBrush}" VerticalAlignment="Center"/>
                <StackPanel Margin="9,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Rec_Title}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTimer" Text="00:00" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="17" Margin="9,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="TxtFrameInfo" Text="0" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" FlowDirection="LeftToRight"/>
                        <TextBlock x:Name="TxtEstimate" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" Margin="10,0,0,0" FlowDirection="LeftToRight"/>
                        <TextBlock x:Name="TxtState" Text="" Foreground="{DynamicResource AccentTextBrush}" FontSize="9.5" Margin="10,0,0,0"/>
                        <StackPanel x:Name="AudioMeterPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Rec_AudioMeter}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <Border Width="42" Height="6" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="1" VerticalAlignment="Center">
                                <Border x:Name="AudioMeterFill" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentBrush}" CornerRadius="1"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="TxtWarning"
                               Text="{DynamicResource Rec_BlackWarning}"
                               ToolTip="{DynamicResource Rec_BlackWarningTip}"
                               Foreground="{DynamicResource WarningTextBrush}"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               MaxWidth="360"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Width="28" Height="27" Margin="0,0,7,0" Click="BtnOpenFolder_Click" ToolTip="{DynamicResource Recent_OpenFolder}" AutomationProperties.Name="{DynamicResource Recent_OpenFolder}">
                    <Path Data="{x:Static views:IconData.Folder}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.35" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <TextBlock Text="{DynamicResource Rec_Fps}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="CmbFps" Width="66" Height="27" Style="{StaticResource CryoComboBox}" SelectionChanged="CmbFps_SelectionChanged" FlowDirection="LeftToRight" ToolTip="{DynamicResource Rec_FpsHint}" AutomationProperties.Name="{DynamicResource Rec_Fps}">
                    <ComboBoxItem Content="15" Tag="15"/>
                    <ComboBoxItem Content="24" Tag="24"/>
                    <ComboBoxItem Content="30" Tag="30"/>
                    <ComboBoxItem Content="60" Tag="60"/>
                </ComboBox>
                <ComboBox x:Name="CmbFormat" Width="74" Height="27" Margin="7,0,0,0" Style="{StaticResource CryoComboBox}" SelectionChanged="CmbFormat_SelectionChanged" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource Rec_Format}">
                    <ComboBoxItem Content="GIF" Tag="GIF"/>
                    <ComboBoxItem Content="MP4" Tag="MP4"/>
                </ComboBox>

                <Rectangle Width="1" Height="24" Fill="{DynamicResource DividerBrush}" Margin="9,0"/>
                <Button x:Name="BtnPause" Content="{DynamicResource Rec_Pause}" Style="{StaticResource SecondaryButton}" Click="BtnPause_Click" Margin="0,0,6,0"/>
                <Button x:Name="BtnStopSave" Content="{DynamicResource Rec_StopSave}" Style="{StaticResource PrimaryButton}" Click="BtnStopSave_Click" Margin="0,0,6,0"/>
                <Button x:Name="BtnStopCopy" Content="{DynamicResource Rec_StopCopy}" Style="{StaticResource SecondaryButton}" Click="BtnStopCopy_Click" Margin="0,0,6,0"/>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnCancel_Click" ToolTip="{DynamicResource Rec_Cancel}" AutomationProperties.Name="{DynamicResource Rec_Cancel}">
                    <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
