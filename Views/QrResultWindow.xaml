<Window x:Class="CryoUtils.Views.QrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Qr_ResultTitle}"
        Width="520"
        Height="360"
        MinHeight="260"
        MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource SegoeUIVariableText}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="6"
                        Background="{DynamicResource InsetBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1"
                        Margin="0,0,10,0"
                        ClipToBounds="True">
                    <Image x:Name="ImgQrThumbnail"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Cursor="Hand"
                           ToolTip="{DynamicResource Tools_QrSave}"
                           MouseLeftButtonDown="ImgQrThumbnail_MouseLeftButtonDown"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Qr_ResultTitle}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="TxtFormat" Text="QR_CODE" Style="{StaticResource MutedText}" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="TxtCharCount"
                       Style="{StaticResource UnitText}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,12"/>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6">
            <TextBox x:Name="TxtContent"
                     Style="{StaticResource CryoTextBox}"
                     FontFamily="{StaticResource CryoMono}"
                     FontSize="12"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="Transparent"
                     IsReadOnly="True"/>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnOpenUrl"
                        Style="{StaticResource PrimaryButton}"
                        Content="{DynamicResource Qr_OpenUrl}"
                        Visibility="Collapsed"
                        Margin="0,0,8,0"
                        Click="BtnOpenUrl_Click"/>
                <Button x:Name="BtnCopy"
                        Style="{StaticResource PrimaryButton}"
                        Content="{DynamicResource Common_Copy}"
                        Margin="0,0,8,0"
                        Click="BtnCopy_Click"/>
                <Button x:Name="BtnSave"
                        Style="{StaticResource SecondaryButton}"
                        Content="{DynamicResource Common_SaveAs}"
                        Margin="0,0,8,0"
                        Click="BtnSave_Click"/>
                <Button x:Name="BtnSaveQrImage"
                        Style="{StaticResource SecondaryButton}"
                        Content="{DynamicResource Tools_QrSave}"
                        Click="BtnSaveQrImage_Click"/>
            </StackPanel>

            <Button Style="{StaticResource SecondaryButton}"
                    Content="{DynamicResource Common_Close}"
                    HorizontalAlignment="Right"
                    Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
