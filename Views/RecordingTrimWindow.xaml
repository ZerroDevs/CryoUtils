<Window x:Class="CryoUtils.Views.RecordingTrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Rec_TrimTitle}"
        Width="760" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SegoeUIVariableText}">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource Rec_TrimTitle}"
                           Foreground="{DynamicResource TextTitleBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="14,0"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Style="{StaticResource CryoScrollViewer}" Padding="18,14,18,8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Rec_TrimHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Border Background="#080C10" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Height="270">
                        <Grid>
                            <MediaElement x:Name="Preview"
                                          Stretch="Uniform"
                                          LoadedBehavior="Manual"
                                          ScrubbingEnabled="True"
                                          MediaOpened="Preview_MediaOpened"
                                          MediaFailed="Preview_MediaFailed"/>
                            <TextBlock x:Name="PreviewEmpty"
                                       Text="{DynamicResource Rec_TrimPreviewEmpty}"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtDuration" Text="00:00" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="11"/>
                        <Button Grid.Column="1" Content="{DynamicResource Rec_TrimPlay}" Style="{StaticResource SecondaryButton}" Padding="10,3" Click="BtnPlay_Click"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Rec_TrimStart}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                        <Slider x:Name="SldStart" Grid.Column="1" Style="{StaticResource CryoSlider}" Minimum="0" Maximum="1" Value="0" ValueChanged="Trim_ValueChanged" Margin="10,0"/>
                        <TextBlock x:Name="TxtStart" Grid.Column="2" Text="00:00.0" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" Width="58" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Rec_TrimEnd}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                        <Slider x:Name="SldEnd" Grid.Column="1" Style="{StaticResource CryoSlider}" Minimum="0" Maximum="1" Value="1" ValueChanged="Trim_ValueChanged" Margin="10,0"/>
                        <TextBlock x:Name="TxtEnd" Grid.Column="2" Text="00:00.0" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" Width="58" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="18,10">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="{DynamicResource Rec_TrimReady}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Common_Cancel}" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnSave" Content="{DynamicResource Rec_TrimSave}" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
