<Window x:Class="CryoUtils.Views.ScrollingCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ScrollCapture_Title}"
        Width="470" Height="154"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource SegoeUIVariableText}">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                <Grid>
                    <TextBlock Text="{DynamicResource ScrollCapture_Title}" Foreground="{DynamicResource TextTitleBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCount" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MutedText}" FontFamily="{StaticResource CryoMono}" FlowDirection="LeftToRight"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="14,10,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource ScrollCapture_Hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="{DynamicResource ScrollCapture_CaptureNow}" Style="{StaticResource SecondaryButton}" Click="BtnCapture_Click" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource ScrollCapture_Finish}" Style="{StaticResource PrimaryButton}" Click="BtnFinish_Click" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Common_Cancel}" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
