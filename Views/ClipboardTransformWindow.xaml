<Window x:Class="CryoUtils.Views.ClipboardTransformWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Clip_TransformPreview}"
        Width="640" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource SegoeUIVariableText}">
    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource Clip_TransformPreview}" Style="{StaticResource PageTitle}" FontSize="18"/>
                <Button Style="{StaticResource TitleActionBtn}" HorizontalAlignment="Right" Click="BtnClose_Click" ToolTip="{DynamicResource Common_Close}" AutomationProperties.Name="{DynamicResource Common_Close}">
                    <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
            </Grid>

            <DockPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Clip_Original}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtOriginal" Style="{StaticResource CryoTextBox}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>

            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Clip_Transformed}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTransformed" Style="{StaticResource CryoTextBox}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{DynamicResource Clip_CopyTransformed}" Style="{StaticResource PrimaryButton}" Click="BtnCopy_Click" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource Common_Close}" Style="{StaticResource SecondaryButton}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
