<Window x:Class="CryoUtils.Views.ImageResizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Editor_ResizeTitle}"
        Width="360" Height="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource SegoeUIVariableText}">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Editor_ResizeTitle}" Style="{StaticResource PageTitle}" FontSize="17"/>
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Editor_Width}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtWidth" Style="{StaticResource CryoTextBox}" FlowDirection="LeftToRight" TextAlignment="Center" TextChanged="Size_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Editor_Height}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtHeight" Style="{StaticResource CryoTextBox}" FlowDirection="LeftToRight" TextAlignment="Center" TextChanged="Size_TextChanged"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="ChkAspect" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Editor_KeepAspect}" IsChecked="True"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Common_Cancel}" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource Editor_Apply}" Style="{StaticResource PrimaryButton}" Click="BtnApply_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
