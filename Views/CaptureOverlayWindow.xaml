<Window x:Class="CryoUtils.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CryoUtils.Views"
        Title="CryoUtils Capture"
        WindowStyle="None"
        Background="#FF000000"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SegoeUIVariableText}"
        FlowDirection="LeftToRight"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="RootGrid">
        <views:CaptureSurface x:Name="Surface"/>

        <Canvas x:Name="ChromeCanvas">
            <Border x:Name="SizeBadge"
                    Background="{DynamicResource OverlayBackgroundBrush}"
                    BorderBrush="{DynamicResource OverlaySelectionBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="7,3"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText"
                           Text="0 x 0"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{StaticResource CryoMono}"
                           FontSize="11"
                           FlowDirection="LeftToRight"/>
            </Border>

            <Border x:Name="CursorCoordsBadge"
                    Background="{DynamicResource OverlayBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="6,2.5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="CursorCoordsText"
                           Text="0, 0"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{StaticResource CryoMono}"
                           FontSize="10.5"
                           FlowDirection="LeftToRight"/>
            </Border>

            <Border x:Name="HintBanner"
                    Background="{DynamicResource OverlayBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,7"
                    IsHitTestVisible="False">
                <TextBlock x:Name="HintText"
                           Text="{DynamicResource Capture_SelectHint}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="11.5"/>
            </Border>

            <Border x:Name="LoupePanel"
                    Width="154"
                    Background="{DynamicResource OverlayBackgroundBrush}"
                    BorderBrush="{DynamicResource OverlaySelectionBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="2">
                        <Image x:Name="LoupeImage"
                               Width="140" Height="96"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <Grid Margin="0,5,0,0">
                        <TextBlock x:Name="LoupeHex"
                                   Text="#000000"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource CryoMono}"
                                   FontSize="11"
                                   FlowDirection="LeftToRight"/>
                        <TextBlock x:Name="LoupeCoords"
                                   Text="0, 0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontFamily="{StaticResource CryoMono}"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   FlowDirection="LeftToRight"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="ThicknessPreview"
                    Background="{DynamicResource OverlayBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="7,4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ThicknessDot"
                             Width="4" Height="4"
                             Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="ThicknessText"
                               Text="3 px"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource CryoMono}"
                               FontSize="10.5"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               FlowDirection="LeftToRight"/>
                </StackPanel>
            </Border>

            <Border x:Name="AnnotationToolbarBorder"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4"
                    Visibility="Collapsed">
                <StackPanel x:Name="AnnotationToolbar"/>
            </Border>

            <Border x:Name="ActionToolbarBorder"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4"
                    Visibility="Collapsed">
                <StackPanel x:Name="ActionToolbar" Orientation="Horizontal"/>
            </Border>

            <TextBox x:Name="TextEditor"
                     Style="{StaticResource CryoTextBox}"
                     Width="280"
                     MinHeight="32"
                     Visibility="Collapsed"
                     AcceptsReturn="False"
                     TextWrapping="NoWrap"
                     FontSize="16"
                     Padding="6,4"
                     BorderThickness="1"
                     Text="{DynamicResource Capture_TextPlaceholder}"
                     KeyDown="TextEditor_KeyDown"
                     TextChanged="TextEditor_TextChanged"
                     LostKeyboardFocus="TextEditor_LostKeyboardFocus"/>
        </Canvas>
    </Grid>
</Window>
