<Window x:Class="CryoUtils.Views.PowerToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CryoUtils.Views"
        Title="{DynamicResource PowerTools_Title}"
        Width="1180" Height="840"
        MinWidth="980" MinHeight="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource SegoeUIVariableText}">

    <Window.Resources>
        <Style x:Key="WorkbenchTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource CryoFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="TabBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid Margin="20,16,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="6"
                        Background="{DynamicResource InsetBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <Image Source="pack://application:,,,/Images/CryoUtils-Icon.png"
                           Width="24" Height="24"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource PowerTools_Title}" Style="{StaticResource PageTitle}" FontSize="23" VerticalAlignment="Center"/>
                        <Border Margin="9,1,0,0" Padding="7,2" CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="LOCAL WORKSPACE" Foreground="{DynamicResource AccentTextBrush}"
                                       FontFamily="{StaticResource CryoMono}" FontSize="8.5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource PowerTools_Subtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource TitleActionBtn}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="BtnClose_Click"
                        ToolTip="{DynamicResource Common_Close}"
                        AutomationProperties.Name="{DynamicResource Common_Close}">
                    <Path Data="{x:Static views:IconData.Close}" Stroke="{DynamicResource IconBrush}"
                          StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
            </Grid>

            <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,18,0,0"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        ItemContainerStyle="{StaticResource WorkbenchTabStyle}">

            </TabControl>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Top"/>
                <TextBlock x:Name="TxtStatus" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" Margin="0,8,0,0"/>
                <TextBlock Text="{DynamicResource PowerTools_Footer}" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="10" Margin="0,8,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
