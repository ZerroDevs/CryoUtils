<Window x:Class="CryoUtils.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SegoeUIVariableText}"
        IsHitTestVisible="False">
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
            <TextBlock x:Name="TxtMessage"
                       Grid.Column="1"
                       Margin="9,0,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="11.5"/>
        </Grid>
    </Border>
</Window>
