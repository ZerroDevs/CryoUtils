<UserControl x:Class="CryoUtils.Views.Tabs.HotkeysTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Background="Transparent">
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource Hotkeys_Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{DynamicResource Hotkeys_Desc}" Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Hotkeys_ResetDefaults}" Style="{StaticResource SecondaryButton}" Click="BtnResetHotkeys_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel x:Name="HotkeyRowsPanel"/>

        <TextBlock Text="{DynamicResource Hotkeys_RequireModifier}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
