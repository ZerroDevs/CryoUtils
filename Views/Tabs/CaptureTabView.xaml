<UserControl x:Class="CryoUtils.Views.Tabs.CaptureTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CryoUtils.Views">
    <StackPanel Background="Transparent">
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Nav_Capture}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{DynamicResource Capture_RecordHint}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource Main_CaptureNow}" Style="{StaticResource PrimaryButton}" Click="BtnHeroCapture_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnCaptureTabRecord" Content="{DynamicResource Main_RecordNow}" Style="{StaticResource SecondaryButton}" Click="BtnRecordNow_Click"/>
            </StackPanel>
        </Grid>

        <Border x:Name="PrintScreenBanner" Style="{StaticResource InsetBorder}" BorderBrush="{DynamicResource WarningTextBrush}" Visibility="Collapsed" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Capture_Contested}" Foreground="{DynamicResource WarningTextBrush}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="{DynamicResource Capture_UseFallback}" Style="{StaticResource SecondaryButton}" Click="BtnUseFallback_Click" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Capture Behaviour & Output -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Data="{x:Static views:IconData.Capture}" Stroke="{DynamicResource CaptureAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Capture_SettingsTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkQuickSave" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_QuickSave}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <TextBlock Text="{DynamicResource Capture_QuickSaveDesc}" Style="{StaticResource MutedText}" Margin="22,3,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Capture_Delay}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbCaptureDelay" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Capture_Delay}">
                                <ComboBoxItem Content="{DynamicResource Capture_DelayInstant}" Tag="0" IsSelected="True"/>
                                <ComboBoxItem Content="{DynamicResource Capture_Delay3s}" Tag="3"/>
                                <ComboBoxItem Content="{DynamicResource Capture_Delay5s}" Tag="5"/>
                                <ComboBoxItem Content="{DynamicResource Capture_Delay10s}" Tag="10"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Capture_ImageFormat}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbImageFormat" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Capture_ImageFormat}">
                                <ComboBoxItem Content="PNG" Tag="PNG"/>
                                <ComboBoxItem Content="JPG" Tag="JPG"/>
                                <ComboBoxItem Content="WEBP" Tag="WEBP"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource Capture_Folder}" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSaveFolder" Style="{StaticResource CryoTextBox}" IsReadOnly="True" FlowDirection="LeftToRight"/>
                        <Button Grid.Column="2" Content="{DynamicResource Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BtnBrowseFolder_Click"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,2,0,12"/>

                    <CheckBox x:Name="ChkAutoCopy" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_AutoCopy}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="ChkCaptureSound" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_Sound}" Margin="0,10,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="ChkShowLoupe" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_Loupe}" Margin="0,10,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <TextBlock Text="{DynamicResource Capture_LoupeDesc}" Style="{StaticResource MutedText}" Margin="22,3,0,0"/>
                    <CheckBox x:Name="ChkPrettyFrame" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_PrettyFrame}" Margin="0,10,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <TextBlock Text="{DynamicResource Capture_PrettyFrameDesc}" Style="{StaticResource MutedText}" Margin="22,3,0,0"/>
                    <CheckBox x:Name="ChkArchiveCopied" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_ArchiveCopied}" Margin="0,12,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <TextBlock Text="{DynamicResource Capture_ArchiveCopiedDesc}" Style="{StaticResource MutedText}" Margin="22,3,0,0"/>
                    <CheckBox x:Name="ChkCloudUpload" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_CloudUpload}" Margin="0,12,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <TextBlock Text="{DynamicResource Capture_CloudUploadDesc}" Style="{StaticResource MutedText}" Margin="22,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Right: Annotations + Recorder -->
            <StackPanel Grid.Column="2">
                <!-- Annotation Defaults -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="{x:Static views:IconData.Edit}" Stroke="{DynamicResource ColorAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Main_HeroKicker}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Capture_DefaultColor}" Style="{StaticResource FieldLabel}"/>
                                <Button x:Name="BtnDefaultColor" Style="{StaticResource SecondaryButton}" Padding="8,5" Click="BtnDefaultColor_Click" AutomationProperties.Name="{DynamicResource Capture_DefaultColor}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="DefaultColorSwatch" Width="14" Height="14" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}"/>
                                        <TextBlock x:Name="TxtDefaultColor" Margin="7,0,0,0" FontFamily="{StaticResource CryoMono}" FontSize="11" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid>
                                    <TextBlock Text="{DynamicResource Capture_Thickness}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtThickness" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" FlowDirection="LeftToRight"/>
                                </Grid>
                                <Slider x:Name="SldThickness" Style="{StaticResource CryoSlider}" Minimum="1" Maximum="14" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Thickness_ValueChanged" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{DynamicResource Capture_StepStart}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtStepStart" Style="{StaticResource CryoTextBox}" Height="30" Padding="6,2" Text="1" FlowDirection="LeftToRight" TextAlignment="Center" LostFocus="TxtStepStart_LostFocus" AutomationProperties.Name="{DynamicResource Capture_StepStart}"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource InsetBorder}">
                            <TextBlock Text="{DynamicResource Capture_OcrNote}" Style="{StaticResource MutedText}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- GIF & Video Recorder Settings -->
                <Border x:Name="CardRecorder" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{x:Static views:IconData.Record}" Stroke="{DynamicResource MediaAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Capture_GifTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="{DynamicResource Rec_SettingsShort}" Style="{StaticResource SecondaryButton}" Padding="8,3" Height="25" HorizontalAlignment="Right" Click="BtnRecorderSettings_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Capture_Fps}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbFps" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource Capture_Fps}">
                                    <ComboBoxItem Content="15" Tag="15"/>
                                    <ComboBoxItem Content="24" Tag="24"/>
                                    <ComboBoxItem Content="30" Tag="30"/>
                                    <ComboBoxItem Content="60" Tag="60"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Capture_Format}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbRecFormat" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource Capture_Format}">
                                    <ComboBoxItem Content="GIF" Tag="GIF"/>
                                    <ComboBoxItem Content="MP4" Tag="MP4"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{DynamicResource Capture_MaxSeconds}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbMaxSeconds" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource Capture_MaxSeconds}">
                                    <ComboBoxItem Content="1 min" Tag="60"/>
                                    <ComboBoxItem Content="5 min" Tag="300"/>
                                    <ComboBoxItem Content="10 min" Tag="600"/>
                                    <ComboBoxItem Content="30 min" Tag="1800"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ChkCopyOnStop" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_CopyOnStop}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <TextBlock x:Name="TxtRecorderSummary" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
