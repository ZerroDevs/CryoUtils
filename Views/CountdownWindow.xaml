<Window x:Class="CryoUtils.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CryoUtils Timer"
        Width="220"
        Height="84"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource OverlayBackgroundBrush}"
            BorderBrush="{DynamicResource OverlaySelectionBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="44" Height="44"
                    CornerRadius="6"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock x:Name="TxtSeconds"
                           Text="3"
                           FontSize="24"
                           FontWeight="Bold"
                           FontFamily="{StaticResource CryoMono}"
                           Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="12,0,8,0">
                <TextBlock Text="{DynamicResource Capture_TimerCountdown}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Capture_TimerHint}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10.5"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="2"
                    x:Name="BtnCancel"
                    Style="{StaticResource SecondaryButton}"
                    Content="{DynamicResource Common_Cancel}"
                    Padding="8,5"
                    FontSize="11"
                    VerticalAlignment="Center"
                    Click="BtnCancel_Click"/>
        </Grid>
    </Border>
</Window>
