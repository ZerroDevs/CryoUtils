<Window x:Class="CryoUtils.Views.DeveloperToolboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Dev_Title}"
        Width="820" Height="620"
        MinWidth="620" MinHeight="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource SegoeUIVariableText}">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dev_Title}" Style="{StaticResource PageTitle}" FontSize="18"/>
                    <TextBlock Text="{DynamicResource Dev_Hint}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource TitleActionBtn}" HorizontalAlignment="Right" Click="BtnClose_Click" ToolTip="{DynamicResource Common_Close}" AutomationProperties.Name="{DynamicResource Common_Close}">
                    <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
            </Grid>

            <WrapPanel Grid.Row="1" Margin="0,10,0,8">
                <Button Content="{DynamicResource Dev_FormatJson}" Style="{StaticResource SecondaryButton}" Click="BtnPrettyJson_Click" Margin="0,0,4,4"/>
                <Button Content="{DynamicResource Dev_MinifyJson}" Style="{StaticResource SecondaryButton}" Click="BtnMinifyJson_Click" Margin="0,0,4,4"/>
                <Button Content="{DynamicResource Dev_FormatXml}" Style="{StaticResource SecondaryButton}" Click="BtnXml_Click" Margin="0,0,4,4"/>
                <Button Content="{DynamicResource Dev_Base64Encode}" Style="{StaticResource SecondaryButton}" Click="BtnBase64Encode_Click" Margin="0,0,4,4"/>
                <Button Content="{DynamicResource Dev_Base64Decode}" Style="{StaticResource SecondaryButton}" Click="BtnBase64Decode_Click" Margin="0,0,4,4"/>
                <Button Content="{DynamicResource Dev_UrlEncode}" Style="{StaticResource SecondaryButton}" Click="BtnUrlEncode_Click" Margin="0,0,4,4"/>
                <Button Content="{DynamicResource Dev_UrlDecode}" Style="{StaticResource SecondaryButton}" Click="BtnUrlDecode_Click" Margin="0,0,4,4"/>
                <Button Content="{DynamicResource Dev_Hash}" Style="{StaticResource SecondaryButton}" Click="BtnHash_Click" Margin="0,0,4,4"/>
                <Button Content="{DynamicResource Dev_Guid}" Style="{StaticResource SecondaryButton}" Click="BtnGuid_Click" Margin="0,0,4,4"/>
            </WrapPanel>

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Dev_Input}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtInput" Style="{StaticResource CryoTextBox}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource CryoMono}" FlowDirection="LeftToRight"/>
            </DockPanel>

            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Dev_Output}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtOutput" Style="{StaticResource CryoTextBox}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource CryoMono}" FlowDirection="LeftToRight"/>
            </DockPanel>

            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Dev_Regex}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtPattern" Grid.Column="1" Style="{StaticResource CryoTextBox}" FlowDirection="LeftToRight" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="{DynamicResource Dev_RegexTest}" Style="{StaticResource SecondaryButton}" Click="BtnRegex_Click" Margin="0,0,4,0"/>
                    <Button Content="{DynamicResource Dev_Copy}" Style="{StaticResource SecondaryButton}" Click="BtnCopy_Click" Margin="0,0,4,0"/>
                    <Button Content="{DynamicResource Dev_Clear}" Style="{StaticResource SecondaryButton}" Click="BtnClear_Click"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TxtStatus" Grid.Row="5" HorizontalAlignment="Left" Text="{DynamicResource Dev_Ready}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        </Grid>
    </Border>
</Window>
