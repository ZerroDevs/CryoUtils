<Window x:Class="CryoUtils.Views.DeveloperToolboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CryoUtils.Views"
        Title="{DynamicResource Dev_Title}"
        Width="780" Height="600"
        MinWidth="580" MinHeight="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Images/CryoUtils.ico"
        FontFamily="{StaticResource SegoeUIVariableText}">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,40,0">
                        <Image Source="pack://application:,,,/Images/CryoUtils-Icon.png"
                               Width="16" Height="16"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Dev_Title}"
                                   Foreground="{DynamicResource TextTitleBrush}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dev_Hint}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10.5"
                                   Margin="10,1,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Style="{StaticResource TitleActionBtn}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Click="BtnClose_Click"
                            ToolTip="{DynamicResource Common_Close}"
                            AutomationProperties.Name="{DynamicResource Common_Close}">
                        <Path Data="{x:Static views:IconData.Close}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Content="{DynamicResource Dev_FormatJson}" Style="{StaticResource SecondaryButton}" Click="BtnPrettyJson_Click" Margin="0,0,5,5"/>
                    <Button Content="{DynamicResource Dev_MinifyJson}" Style="{StaticResource SecondaryButton}" Click="BtnMinifyJson_Click" Margin="0,0,5,5"/>
                    <Button Content="{DynamicResource Dev_FormatXml}" Style="{StaticResource SecondaryButton}" Click="BtnXml_Click" Margin="0,0,5,5"/>
                    <Button Content="{DynamicResource Dev_Base64Encode}" Style="{StaticResource SecondaryButton}" Click="BtnBase64Encode_Click" Margin="0,0,5,5"/>
                    <Button Content="{DynamicResource Dev_Base64Decode}" Style="{StaticResource SecondaryButton}" Click="BtnBase64Decode_Click" Margin="0,0,5,5"/>
                    <Button Content="{DynamicResource Dev_UrlEncode}" Style="{StaticResource SecondaryButton}" Click="BtnUrlEncode_Click" Margin="0,0,5,5"/>
                    <Button Content="{DynamicResource Dev_UrlDecode}" Style="{StaticResource SecondaryButton}" Click="BtnUrlDecode_Click" Margin="0,0,5,5"/>
                    <Button Content="{DynamicResource Dev_Hash}" Style="{StaticResource SecondaryButton}" Click="BtnHash_Click" Margin="0,0,5,5"/>
                    <Button Content="{DynamicResource Dev_Guid}" Style="{StaticResource SecondaryButton}" Click="BtnGuid_Click" Margin="0,0,5,5"/>
                </WrapPanel>

                <DockPanel Grid.Row="1">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Dev_Input}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtInput" Style="{StaticResource CryoTextBox}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource CryoMono}" FlowDirection="LeftToRight"/>
                </DockPanel>

                <DockPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Dev_Output}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtOutput" Style="{StaticResource CryoTextBox}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource CryoMono}" FlowDirection="LeftToRight"/>
                </DockPanel>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Dev_Regex}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtPattern" Grid.Column="1" Style="{StaticResource CryoTextBox}" FlowDirection="LeftToRight" Margin="0,0,6,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="{DynamicResource Dev_RegexTest}" Style="{StaticResource SecondaryButton}" Click="BtnRegex_Click" Margin="0,0,4,0"/>
                        <Button Content="{DynamicResource Dev_Copy}" Style="{StaticResource SecondaryButton}" Click="BtnCopy_Click" Margin="0,0,4,0"/>
                        <Button Content="{DynamicResource Dev_Clear}" Style="{StaticResource SecondaryButton}" Click="BtnClear_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                <TextBlock x:Name="TxtStatus" Text="{DynamicResource Dev_Ready}" Style="{StaticResource MutedText}" FontSize="10.5" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
