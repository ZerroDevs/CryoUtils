<Window x:Class="CryoUtils.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CryoUtils.Views"
        Title="{DynamicResource App_Title}"
        Width="1040" Height="710"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SegoeUIVariableText}"
        Icon="pack://application:,,,/Images/CryoUtils.ico"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Cryo-Family Custom Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Identity & Version -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Images/CryoUtils-Icon.png"
                           Width="20" Height="20"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource App_Title}"
                               Foreground="{DynamicResource TextTitleBrush}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="2"
                            Background="{DynamicResource InsetBackgroundBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitleVersion"
                                   Text=""
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="{StaticResource CryoMono}"
                                   FontSize="9.5"
                                   FlowDirection="LeftToRight"/>
                    </Border>
                </StackPanel>

                <!-- Right: Hotkey, Primary Launchers, Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border Style="{StaticResource HotkeyPill}" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderHotkey"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontFamily="{StaticResource CryoMono}"
                                   FontSize="10"
                                   FlowDirection="LeftToRight"/>
                    </Border>
                    <Button Content="{DynamicResource Main_CaptureNow}"
                            Style="{StaticResource PrimaryButton}"
                            Height="25"
                            Padding="11,0"
                            FontSize="11"
                            VerticalContentAlignment="Center"
                            Click="BtnHeroCapture_Click"
                            Margin="0,0,5,0"/>
                    <Button Content="{DynamicResource Main_RecordNow}"
                            Style="{StaticResource SecondaryButton}"
                            Height="25"
                            Padding="11,0"
                            FontSize="11"
                            VerticalContentAlignment="Center"
                            Click="BtnRecordNow_Click"
                            Margin="0,0,8,0"/>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource DividerBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                    <Button x:Name="BtnQuit"
                            Style="{StaticResource TitleActionBtn}"
                            Click="BtnQuit_Click"
                            Margin="0,0,2,0"
                            ToolTip="{DynamicResource Main_TooltipQuit}"
                            AutomationProperties.Name="{DynamicResource Main_TooltipQuit}">
                        <Path x:Name="PathQuitIcon"
                              Data="{x:Static views:IconData.Power}"
                              Stroke="{DynamicResource IconBrush}"
                              StrokeThickness="1.5"
                              Width="12" Height="12"
                              Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource TitleActionBtn}"
                            Click="BtnClose_Click"
                            ToolTip="{DynamicResource Main_TooltipMinimize}"
                            AutomationProperties.Name="{DynamicResource Main_TooltipMinimize}">
                        <Path Data="{x:Static views:IconData.Close}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Unified Horizontal Tab Navigation Strip (CryoTray Settings Pattern) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="14,2,14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <RadioButton x:Name="TabOverview"
                                     GroupName="MainNav"
                                     Style="{StaticResource TabButtonStyle}"
                                     Tag="Overview"
                                     IsChecked="True"
                                     Checked="Tab_Checked"
                                     ToolTip="{DynamicResource Nav_Overview}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{x:Static views:IconData.Home}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav_Overview}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabCapture"
                                     GroupName="MainNav"
                                     Style="{StaticResource TabButtonStyle}"
                                     Tag="Capture"
                                     Checked="Tab_Checked"
                                     ToolTip="{DynamicResource Nav_Capture}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{x:Static views:IconData.Capture}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav_Capture}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabTools"
                                     GroupName="MainNav"
                                     Style="{StaticResource TabButtonStyle}"
                                     Tag="Tools"
                                     Checked="Tab_Checked"
                                     ToolTip="{DynamicResource Nav_Tools}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{x:Static views:IconData.Tools}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav_Tools}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabHotkeys"
                                     GroupName="MainNav"
                                     Style="{StaticResource TabButtonStyle}"
                                     Tag="Hotkeys"
                                     Checked="Tab_Checked"
                                     ToolTip="{DynamicResource Nav_Hotkeys}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{x:Static views:IconData.Keyboard}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav_Hotkeys}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabGeneral"
                                     GroupName="MainNav"
                                     Style="{StaticResource TabButtonStyle}"
                                     Tag="General"
                                     Checked="Tab_Checked"
                                     ToolTip="{DynamicResource Nav_General}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{x:Static views:IconData.Settings}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Nav_General}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="9,3"
                            Margin="0,0,0,4"
                            CornerRadius="3"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtModuleCount"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontFamily="{StaticResource CryoMono}"
                                   FontSize="10.5"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Row 2: Main Content Area -->
            <ScrollViewer x:Name="MainContentScroll" Grid.Row="2" Style="{StaticResource CryoScrollViewer}" Padding="20,14,20,14">
                <Grid Background="Transparent">
                    <!-- ==================== OVERVIEW ==================== -->
                    <StackPanel x:Name="PanelOverview" Background="Transparent">

                        <!-- Cryo-Family Hero Command Banner (Single Title, Zero Duplication) -->
                        <Border CornerRadius="4"
                                ClipToBounds="True"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E4F7A" Offset="0"/>
                                    <GradientStop Color="#18649C" Offset="0.6"/>
                                    <GradientStop Color="#165788" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <!-- Subtle technical geometric traces inspired by CryoTray's PCB overlay -->
                                <Path Data="M640,0 L710,70 L920,70 M760,0 L805,45 L980,45 M560,96 L650,96 L690,56"
                                      Stroke="#1CFFFFFF" StrokeThickness="1.2" Fill="Transparent" IsHitTestVisible="False"/>
                                <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                                            <GradientStop Color="#18FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <Grid Margin="16,11,16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{DynamicResource Main_OverviewTitle}"
                                                   Foreground="#FFFFFF"
                                                   FontFamily="{StaticResource SegoeUIVariable}"
                                                   FontSize="17.5"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{DynamicResource Main_OverviewSubtitle}"
                                                   Foreground="#DCECF8"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource Main_CaptureNow}"
                                                Click="BtnHeroCapture_Click"
                                                Background="#FFFFFF"
                                                Foreground="#143D61"
                                                BorderBrush="#FFFFFF"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="{DynamicResource Main_RecordNow}"
                                                Click="BtnRecordNow_Click"
                                                Background="#22FFFFFF"
                                                Foreground="#FFFFFF"
                                                BorderBrush="#4DFFFFFF"
                                                Style="{StaticResource SecondaryButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 4 Roomy Quick Launch Tiles (Domain Accent Coded, Zero Clipping) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tile 1: Take Screenshot -->
                            <Button Grid.Column="0" Style="{StaticResource QuickTileButton}" MinHeight="48" Padding="10,7" Click="BtnQuickCapture_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="4"
                                            Background="{DynamicResource InsetBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{x:Static views:IconData.Capture}" Stroke="{DynamicResource CaptureAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Main_CaptureNow}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{DynamicResource Overview_TileCaptureSub}" Foreground="{DynamicResource CaptureAccentBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Tile 2: Record GIF -->
                            <Button Grid.Column="2" Style="{StaticResource QuickTileButton}" MinHeight="48" Padding="10,7" Click="BtnRecordNow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="4"
                                            Background="{DynamicResource InsetBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{x:Static views:IconData.Record}" Stroke="{DynamicResource MediaAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Main_RecordNow}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="GIF / MP4" Foreground="{DynamicResource MediaAccentBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" Margin="0,1,0,0" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Tile 3: Colour Picker -->
                            <Button x:Name="BtnQuickColorTile"
                                    Grid.Column="4"
                                    Style="{StaticResource QuickTileButton}"
                                    MinHeight="48"
                                    Padding="10,7"
                                    AutomationProperties.Name="{DynamicResource Overview_LaunchColor}"
                                    Click="BtnQuickColor_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="4"
                                            Background="{DynamicResource InsetBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{x:Static views:IconData.Droplet}" Stroke="{DynamicResource ColorAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Overview_LaunchColor}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Ctrl+Shift+C · HEX/RGB" Foreground="{DynamicResource ColorAccentBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" Margin="0,1,0,0" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Tile 4: QR Code Suite -->
                            <Button Grid.Column="6" Style="{StaticResource QuickTileButton}" MinHeight="48" Padding="10,7" Click="BtnGoQr_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="4"
                                            Background="{DynamicResource InsetBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{x:Static views:IconData.QrCode}" Stroke="{DynamicResource UtilityAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Overview_LaunchQr}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{DynamicResource Overview_TileQrSub}" Foreground="{DynamicResource UtilityAccentBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>

                        <!-- Recent Captures Strip -->
                        <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{x:Static views:IconData.Capture}" Stroke="{DynamicResource CaptureAccentBrush}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Recent_Title}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbRecentScope"
                                                  Style="{StaticResource CryoComboBox}"
                                                  Margin="10,0,0,0"
                                                  Height="25"
                                                  MinWidth="100"
                                                  Padding="8,1,22,1"
                                                  FontSize="11"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="CmbRecentScope_SelectionChanged"
                                                  AutomationProperties.Name="{DynamicResource Recent_Title}">
                                            <ComboBoxItem Content="{DynamicResource Recent_ScopeSession}" Tag="Session" IsSelected="True"/>
                                            <ComboBoxItem Content="{DynamicResource Recent_ScopeAllTime}" Tag="AllTime"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Click="RecentOpenFolder_Click"
                                            Padding="10,4"
                                            Height="26"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{x:Static views:IconData.Folder}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.35" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource Recent_OpenFolder}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border x:Name="RecentEmpty" Style="{StaticResource InsetBorder}" Padding="12,10">
                                    <TextBlock Text="{DynamicResource Recent_Empty}" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                </Border>

                                <ScrollViewer x:Name="RecentScroll"
                                              Background="Transparent"
                                              Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="240">
                                    <ItemsControl x:Name="RecentItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource CardBorder}" Width="216" Margin="0,0,10,8" Padding="7" Background="{DynamicResource InsetBackgroundBrush}">
                                                    <StackPanel>
                                                        <Border Height="78"
                                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Cursor="Hand"
                                                                ClipToBounds="True"
                                                                Tag="{Binding}"
                                                                MouseLeftButtonUp="RecentThumbnail_Click"
                                                                ToolTip="{DynamicResource Recent_EditTip}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <Border Background="#75080C10" Cursor="Hand">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Opacity" Value="0"/>
                                                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                                                                                    <Setter Property="Opacity" Value="1"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Border Width="28" Height="28"
                                                                            CornerRadius="14"
                                                                            Background="{DynamicResource AccentButtonBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                                        <Path Data="{x:Static views:IconData.Edit}"
                                                                              Stroke="{DynamicResource AccentButtonTextBrush}"
                                                                              StrokeThickness="1.3"
                                                                              Width="13" Height="13"
                                                                              Stretch="Uniform"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   ToolTip="{Binding DisplayName}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   FlowDirection="LeftToRight"
                                                                   HorizontalAlignment="Left"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,5,0,0"/>
                                                        <TextBlock Text="{Binding SizeText}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontFamily="{StaticResource CryoMono}"
                                                                   FontSize="9.5"
                                                                   FlowDirection="LeftToRight"
                                                                   HorizontalAlignment="Left"
                                                                   Margin="0,2,0,5"/>

                                                        <Button Content="{DynamicResource Recent_Copy}" Tag="{Binding}" Click="RecentCopy_Click" Style="{StaticResource PrimaryButton}" Height="25" Padding="0" FontSize="10.5" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="26"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0" Content="{DynamicResource Recent_Compress}" Tag="{Binding}" Click="RecentCompress_Click" Style="{StaticResource SecondaryButton}" Height="23" FontSize="9.5" Padding="4,1" ToolTip="{DynamicResource Recent_Compress}"/>

                                                            <Button Grid.Column="2" Tag="{Binding}" Click="RecentDelete_Click" Style="{StaticResource SecondaryButton}" Width="26" Height="23" Padding="0" Background="{Binding DeleteBackground}" BorderBrush="{Binding DeleteBorderBrush}" ToolTip="{Binding DeleteToolTip}">
                                                                <Path Data="{Binding DeleteIcon}" Stroke="{Binding DeleteIconBrush}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- 6 Module Control Cards (2x3 Grid, NO Duplicate Heading, Domain Colored Icons) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 1. Screen Capture & Annotation -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,10,0">
                                                <Path Data="{x:Static views:IconData.Capture}" Stroke="{DynamicResource CaptureAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource Module_CaptureName}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="ChkModuleCapture" Style="{StaticResource ToggleSwitch}" Tag="Capture" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" AutomationProperties.Name="{DynamicResource Module_CaptureName}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{DynamicResource Module_CaptureDesc}" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource HotkeyPill}">
                                                <TextBlock x:Name="TxtHotkeyCapture" FontFamily="{StaticResource CryoMono}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FlowDirection="LeftToRight"/>
                                            </Border>
                                            <Button Content="{DynamicResource Module_QuickLaunch}" Style="{StaticResource SecondaryButton}" Click="BtnQuickCapture_Click" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <Button Content="{DynamicResource Recent_Compress}" Style="{StaticResource LinkButton}" Click="BtnGoCompress_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 2. Precision Colour Picker -->
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,10,0">
                                                <Path Data="{x:Static views:IconData.Droplet}" Stroke="{DynamicResource ColorAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource Module_ColorName}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="ChkModuleColor" Style="{StaticResource ToggleSwitch}" Tag="Color" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" AutomationProperties.Name="{DynamicResource Module_ColorName}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{DynamicResource Module_ColorDesc}" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource HotkeyPill}">
                                                <TextBlock x:Name="TxtHotkeyColor" FontFamily="{StaticResource CryoMono}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FlowDirection="LeftToRight"/>
                                            </Border>
                                            <Button Content="{DynamicResource Module_QuickLaunch}" Style="{StaticResource SecondaryButton}" Click="BtnQuickColor_Click" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 3. Always on Top -->
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,10,0">
                                                <Path Data="{x:Static views:IconData.Pin}" Stroke="{DynamicResource ColorAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource Module_PinnerName}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="ChkModulePinner" Style="{StaticResource ToggleSwitch}" Tag="Pinner" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" AutomationProperties.Name="{DynamicResource Module_PinnerName}"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtOverviewPinnedStatus" Grid.Row="1" Text="{DynamicResource Module_PinnerDesc}" Style="{StaticResource MutedText}" Margin="0,8,0,12" TextTrimming="CharacterEllipsis"/>
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource HotkeyPill}">
                                                <TextBlock x:Name="TxtHotkeyPinner" FontFamily="{StaticResource CryoMono}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FlowDirection="LeftToRight"/>
                                            </Border>
                                            <Button Content="{DynamicResource Module_QuickLaunch}" Style="{StaticResource SecondaryButton}" Click="BtnQuickPinner_Click" Margin="8,0,0,0"/>
                                            <Button x:Name="BtnOverviewUnpin" Content="{DynamicResource Tools_Unpin}" Style="{StaticResource DangerButton}" Click="BtnUnpin_Click" Margin="6,0,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 4. Image and GIF Compressor -->
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,10,0">
                                                <Path Data="{x:Static views:IconData.Compress}" Stroke="{DynamicResource MediaAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource Module_CompressorName}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="ChkModuleCompressor" Style="{StaticResource ToggleSwitch}" Tag="Compressor" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" AutomationProperties.Name="{DynamicResource Module_CompressorName}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{DynamicResource Module_CompressorDesc}" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
                                    <Grid Grid.Row="2">
                                        <Button Content="{DynamicResource Module_QuickLaunch}" Style="{StaticResource SecondaryButton}" Click="BtnGoCompress_Click" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 5. Plain Paste & Clipboard History -->
                            <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,10,0">
                                                <Path Data="{x:Static views:IconData.Clipboard}" Stroke="{DynamicResource UtilityAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource Module_ClipboardName}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="ChkModuleClipboard" Style="{StaticResource ToggleSwitch}" Tag="Clipboard" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" AutomationProperties.Name="{DynamicResource Module_ClipboardName}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{DynamicResource Module_ClipboardDesc}" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource HotkeyPill}">
                                                <TextBlock x:Name="TxtHotkeyClipboard" FontFamily="{StaticResource CryoMono}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FlowDirection="LeftToRight"/>
                                            </Border>
                                            <Button Content="{DynamicResource Module_QuickLaunch}" Style="{StaticResource SecondaryButton}" Click="BtnQuickClipboard_Click" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 6. QR Code Suite -->
                            <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,10,0">
                                                <Path Data="{x:Static views:IconData.QrCode}" Stroke="{DynamicResource UtilityAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource Tools_QrTitle}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{DynamicResource Tools_QrDesc}" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{DynamicResource Module_QuickLaunch}" Style="{StaticResource SecondaryButton}" Click="BtnGoQr_Click" Margin="0,0,8,0"/>
                                            <Button Content="{DynamicResource Tools_QrScanScreen}" Style="{StaticResource SecondaryButton}" Click="BtnQrScanScreen_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ==================== CAPTURE ==================== -->
                    <StackPanel x:Name="PanelCapture" Background="Transparent" Visibility="Collapsed">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Nav_Capture}" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="{DynamicResource Capture_RecordHint}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource Main_CaptureNow}" Style="{StaticResource PrimaryButton}" Click="BtnHeroCapture_Click" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Main_RecordNow}" Style="{StaticResource SecondaryButton}" Click="BtnRecordNow_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="PrintScreenBanner" Style="{StaticResource InsetBorder}" BorderBrush="{DynamicResource WarningTextBrush}" Visibility="Collapsed" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Capture_Contested}" Foreground="{DynamicResource WarningTextBrush}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{DynamicResource Capture_UseFallback}" Style="{StaticResource SecondaryButton}" Click="BtnUseFallback_Click" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Capture Behaviour & Output -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Path Data="{x:Static views:IconData.Capture}" Stroke="{DynamicResource CaptureAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Capture_SettingsTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <CheckBox x:Name="ChkQuickSave" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_QuickSave}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <TextBlock Text="{DynamicResource Capture_QuickSaveDesc}" Style="{StaticResource MutedText}" Margin="22,3,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Capture_Delay}" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="CmbCaptureDelay" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Capture_Delay}">
                                                <ComboBoxItem Content="{DynamicResource Capture_DelayInstant}" Tag="0" IsSelected="True"/>
                                                <ComboBoxItem Content="{DynamicResource Capture_Delay3s}" Tag="3"/>
                                                <ComboBoxItem Content="{DynamicResource Capture_Delay5s}" Tag="5"/>
                                                <ComboBoxItem Content="{DynamicResource Capture_Delay10s}" Tag="10"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Capture_ImageFormat}" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="CmbImageFormat" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Capture_ImageFormat}">
                                                <ComboBoxItem Content="PNG" Tag="PNG"/>
                                                <ComboBoxItem Content="JPG" Tag="JPG"/>
                                                <ComboBoxItem Content="WEBP" Tag="WEBP"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{DynamicResource Capture_Folder}" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSaveFolder" Style="{StaticResource CryoTextBox}" IsReadOnly="True" FlowDirection="LeftToRight"/>
                                        <Button Grid.Column="2" Content="{DynamicResource Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BtnBrowseFolder_Click"/>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,2,0,12"/>

                                    <CheckBox x:Name="ChkAutoCopy" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_AutoCopy}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <CheckBox x:Name="ChkCaptureSound" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_Sound}" Margin="0,10,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <CheckBox x:Name="ChkShowLoupe" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_Loupe}" Margin="0,10,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <TextBlock Text="{DynamicResource Capture_LoupeDesc}" Style="{StaticResource MutedText}" Margin="22,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Right: Annotations + Recorder -->
                            <StackPanel Grid.Column="2">
                                <!-- Annotation Defaults -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Path Data="{x:Static views:IconData.Edit}" Stroke="{DynamicResource ColorAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource Main_HeroKicker}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="96"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Capture_DefaultColor}" Style="{StaticResource FieldLabel}"/>
                                                <Button x:Name="BtnDefaultColor" Style="{StaticResource SecondaryButton}" Padding="8,5" Click="BtnDefaultColor_Click" AutomationProperties.Name="{DynamicResource Capture_DefaultColor}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="DefaultColorSwatch" Width="14" Height="14" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}"/>
                                                        <TextBlock x:Name="TxtDefaultColor" Margin="7,0,0,0" FontFamily="{StaticResource CryoMono}" FontSize="11" FlowDirection="LeftToRight"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <Grid>
                                                    <TextBlock Text="{DynamicResource Capture_Thickness}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtThickness" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" FlowDirection="LeftToRight"/>
                                                </Grid>
                                                <Slider x:Name="SldThickness" Style="{StaticResource CryoSlider}" Minimum="1" Maximum="14" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Thickness_ValueChanged" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="{DynamicResource Capture_StepStart}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtStepStart" Style="{StaticResource CryoTextBox}" Height="30" Padding="6,2" Text="1" FlowDirection="LeftToRight" TextAlignment="Center" LostFocus="TxtStepStart_LostFocus" AutomationProperties.Name="{DynamicResource Capture_StepStart}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource InsetBorder}">
                                            <TextBlock Text="{DynamicResource Capture_OcrNote}" Style="{StaticResource MutedText}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- GIF & Video Recorder Settings -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Path Data="{x:Static views:IconData.Record}" Stroke="{DynamicResource MediaAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource Capture_GifTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Capture_Fps}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbFps" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource Capture_Fps}">
                                                    <ComboBoxItem Content="15" Tag="15"/>
                                                    <ComboBoxItem Content="24" Tag="24"/>
                                                    <ComboBoxItem Content="30" Tag="30"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Capture_Format}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbRecFormat" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource Capture_Format}">
                                                    <ComboBoxItem Content="GIF" Tag="GIF"/>
                                                    <ComboBoxItem Content="MP4" Tag="MP4"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="{DynamicResource Capture_MaxSeconds}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbMaxSeconds" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource Capture_MaxSeconds}">
                                                    <ComboBoxItem Content="10" Tag="10"/>
                                                    <ComboBoxItem Content="20" Tag="20"/>
                                                    <ComboBoxItem Content="30" Tag="30"/>
                                                    <ComboBoxItem Content="60" Tag="60"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox x:Name="ChkCopyOnStop" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_CopyOnStop}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ==================== TOOLS & UTILITIES ==================== -->
                    <StackPanel x:Name="PanelTools" Background="Transparent" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Nav_Tools}" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

                        <!-- Workbench 1: Image & GIF Compressor -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{x:Static views:IconData.Compress}" Stroke="{DynamicResource MediaAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Tools_CompressorTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="{DynamicResource Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BtnBrowseCompress_Click" Padding="10,4" Height="26" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource Tools_CompressorDesc}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="DropZone"
                                            Grid.Column="0"
                                            Height="138"
                                            Background="{DynamicResource InsetBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            AllowDrop="True"
                                            Cursor="Hand"
                                            DragOver="DropZone_DragOver"
                                            Drop="DropZone_Drop"
                                            MouseLeftButtonDown="DropZone_MouseLeftButtonDown">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                                            <Path Data="{x:Static views:IconData.Compress}" Stroke="{DynamicResource MediaAccentBrush}" StrokeThickness="1.4" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCompressFileName" Text="{DynamicResource Tools_Dropzone}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                            <TextBlock Text="{DynamicResource Tools_DropzoneHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Tools_Preset}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbPreset" Style="{StaticResource CryoComboBox}" SelectionChanged="CmbPreset_SelectionChanged" AutomationProperties.Name="{DynamicResource Tools_Preset}">
                                            <ComboBoxItem Content="{DynamicResource Tools_PresetDiscord}" Tag="Discord"/>
                                            <ComboBoxItem Content="{DynamicResource Tools_PresetWhatsApp}" Tag="WhatsApp"/>
                                            <ComboBoxItem Content="{DynamicResource Tools_PresetCustom}" Tag="Custom"/>
                                        </ComboBox>

                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Text="{DynamicResource Tools_Quality}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtQualityValue" Text="82%" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" FlowDirection="LeftToRight"/>
                                        </Grid>
                                        <Slider x:Name="SldQuality" Style="{StaticResource CryoSlider}" Minimum="20" Maximum="100" Value="82" ValueChanged="Compression_ValueChanged" IsSnapToTickEnabled="True" TickFrequency="1"/>

                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="{DynamicResource Tools_Scale}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtScaleValue" Text="100%" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" FlowDirection="LeftToRight"/>
                                        </Grid>
                                        <Slider x:Name="SldScale" Style="{StaticResource CryoSlider}" Minimum="20" Maximum="100" Value="100" ValueChanged="Compression_ValueChanged" IsSnapToTickEnabled="True" TickFrequency="5"/>

                                        <Button x:Name="BtnCompress" Content="{DynamicResource Tools_CompressButton}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="BtnCompress_Click" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource InsetBorder}" Padding="10,8" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtCompressStatus" Text="{DynamicResource Tools_NoResult}" Style="{StaticResource MutedText}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{DynamicResource Tools_Before}" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtBeforeSize" Text="--" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" FlowDirection="LeftToRight"/>
                                                <TextBlock Text="{DynamicResource Tools_After}" Style="{StaticResource FieldLabel}" Margin="16,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtAfterSize" Text="--" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" FlowDirection="LeftToRight"/>
                                                <TextBlock Text="{DynamicResource Tools_Saved}" Style="{StaticResource FieldLabel}" Margin="16,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtSaved" Text="--" Foreground="{DynamicResource MediaAccentBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" FlowDirection="LeftToRight"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="88" Height="56" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,10,0">
                                            <Image x:Name="ImgCompressedPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <Button x:Name="BtnSaveCompressed" Content="{DynamicResource Tools_SaveAs}" Style="{StaticResource SecondaryButton}" Click="BtnSaveCompressed_Click" IsEnabled="False" Margin="0,0,6,0"/>
                                        <Button x:Name="BtnCopyCompressed" Content="{DynamicResource Tools_CopyFile}" Style="{StaticResource SecondaryButton}" Click="BtnCopyCompressed_Click" IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Row 2: Color Studio (Contrast + Recent Colors Combined) & QR Suite -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Contrast Checker & Recent Colours -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{x:Static views:IconData.Contrast}" Stroke="{DynamicResource ColorAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource Tools_ColorStudio}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Content="{DynamicResource Overview_LaunchColor}" Style="{StaticResource SecondaryButton}" Click="BtnQuickColor_Click" Padding="9,3" Height="24" FontSize="10.5" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Tools_ContrastDesc}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Tools_ColorA}" Style="{StaticResource FieldLabel}"/>
                                            <Grid>
                                                <TextBox x:Name="TxtContrastA" Style="{StaticResource CryoTextBox}" Text="#FFFFFF" FontFamily="{StaticResource CryoMono}" Height="30" Padding="28,3,6,3" FlowDirection="LeftToRight" TextChanged="ContrastColor_TextChanged" AutomationProperties.Name="{DynamicResource Tools_ColorA}"/>
                                                <Border x:Name="SwatchContrastA" Width="16" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Background="#FFFFFF" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                                            </Grid>
                                        </StackPanel>

                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="8,16,8,0" Click="BtnSwapContrastColors_Click" ToolTip="Swap" AutomationProperties.Name="Swap" VerticalAlignment="Center">
                                            <Path Data="M4,8 L14,8 M11,5 L14,8 L11,11 M14,14 L4,14 M7,11 L4,14 L7,17" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform"/>
                                        </Button>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Tools_ColorB}" Style="{StaticResource FieldLabel}"/>
                                            <Grid>
                                                <TextBox x:Name="TxtContrastB" Style="{StaticResource CryoTextBox}" Text="#1E6FAE" FontFamily="{StaticResource CryoMono}" Height="30" Padding="28,3,6,3" FlowDirection="LeftToRight" TextChanged="ContrastColor_TextChanged" AutomationProperties.Name="{DynamicResource Tools_ColorB}"/>
                                                <Border x:Name="SwatchContrastB" Width="16" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Background="#1E6FAE" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,12,0,0" Padding="10,8" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Tools_ContrastRatio}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                                <TextBlock x:Name="TxtDashboardContrastRatio" Text="5.36:1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="17" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{DynamicResource Tools_WcagAa}" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <Border x:Name="BadgeWcagAaNormal" Padding="5,1" CornerRadius="2" Background="{DynamicResource SuccessMutedBrush}" Margin="0,0,4,0">
                                                        <TextBlock x:Name="TxtWcagAaNormal" Text="Normal: Pass" Foreground="{DynamicResource SuccessBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border x:Name="BadgeWcagAaLarge" Padding="5,1" CornerRadius="2" Background="{DynamicResource SuccessMutedBrush}">
                                                        <TextBlock x:Name="TxtWcagAaLarge" Text="Large: Pass" Foreground="{DynamicResource SuccessBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource Tools_WcagAaa}" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <Border x:Name="BadgeWcagAaaNormal" Padding="5,1" CornerRadius="2" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,4,0">
                                                        <TextBlock x:Name="TxtWcagAaaNormal" Text="Normal: Fail" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border x:Name="BadgeWcagAaaLarge" Padding="5,1" CornerRadius="2" Background="{DynamicResource SuccessMutedBrush}">
                                                        <TextBlock x:Name="TxtWcagAaaLarge" Text="Large: Pass" Foreground="{DynamicResource SuccessBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,12,0,10"/>
                                    <TextBlock Text="{DynamicResource Tools_RecentColors}" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtRecentColorsEmpty" Text="{DynamicResource Tools_RecentColorsEmpty}" Style="{StaticResource MutedText}"/>
                                    <WrapPanel x:Name="RecentColorsPanel" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Right: QR Code Suite -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{x:Static views:IconData.QrCode}" Stroke="{DynamicResource UtilityAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource Tools_QrTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="{DynamicResource Tools_QrScanScreen}" Style="{StaticResource SecondaryButton}" Click="BtnQrScanScreen_Click" Padding="9,3" Height="24" FontSize="10.5" Margin="0,0,6,0"/>
                                            <Button Content="{DynamicResource Tools_QrScanFile}" Style="{StaticResource SecondaryButton}" Click="BtnQrScanFile_Click" Padding="9,3" Height="24" FontSize="10.5"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Tools_QrDesc}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Tools_QrInput}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtQrInput" Style="{StaticResource CryoTextBox}" Height="82" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" TextChanged="TxtQrInput_TextChanged" AutomationProperties.Name="{DynamicResource Tools_QrInput}"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Width="104" Height="104" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3" VerticalAlignment="Bottom">
                                            <Image x:Name="ImgQrPreview" Width="96" Height="96" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnCopyQr" Content="{DynamicResource Tools_QrCopy}" Style="{StaticResource PrimaryButton}" Click="BtnCopyQr_Click" IsEnabled="False" Margin="0,0,6,0"/>
                                            <Button x:Name="BtnSaveQr" Content="{DynamicResource Tools_QrSave}" Style="{StaticResource SecondaryButton}" Click="BtnSaveQr_Click" IsEnabled="False"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Tools_QrCorrection}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="CmbQrCorrection" Width="56" Height="26" Style="{StaticResource CryoComboBox}" SelectionChanged="CmbQrCorrection_SelectionChanged" AutomationProperties.Name="{DynamicResource Tools_QrCorrection}">
                                                <ComboBoxItem Content="M" Tag="M" IsSelected="True"/>
                                                <ComboBoxItem Content="L" Tag="L"/>
                                                <ComboBoxItem Content="Q" Tag="Q"/>
                                                <ComboBoxItem Content="H" Tag="H"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Row 3: Pinned Window & Clipboard History -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="{x:Static views:IconData.Pin}" Stroke="{DynamicResource ColorAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Tools_PinnedTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtPinnedWindow" Text="{DynamicResource Tools_PinnedNone}" Style="{StaticResource MutedText}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnUnpin" Content="{DynamicResource Tools_Unpin}" Style="{StaticResource SecondaryButton}" Click="BtnUnpin_Click" IsEnabled="False" Margin="0,0,6,0"/>
                                            <Button x:Name="BtnResetPinner" Content="{DynamicResource Tools_ResetPinner}" Style="{StaticResource DangerButton}" Click="BtnResetPinner_Click"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{DynamicResource Tools_PinnedOpacity}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtPinnedOpacity" Text="100%" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" FlowDirection="LeftToRight"/>
                                            </Grid>
                                            <Slider x:Name="SldPinnedOpacity" Style="{StaticResource CryoSlider}" Minimum="20" Maximum="100" Value="100" ValueChanged="PinnedOpacity_ValueChanged" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="ChkPinnedClickThrough" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Tools_PinnedClickThrough}" Margin="0,10,0,0" Checked="PinnedClickThrough_Changed" Unchecked="PinnedClickThrough_Changed"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="{x:Static views:IconData.Clipboard}" Stroke="{DynamicResource UtilityAccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Tools_ClipboardTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtClipboardCount" Text="{DynamicResource Tools_ClipboardEmpty}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtClipboardNote" Text="{DynamicResource Tools_ClipboardDesc}" Style="{StaticResource MutedText}" Margin="0,0,0,14"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{DynamicResource Tools_ClipboardOpen}" Style="{StaticResource PrimaryButton}" Click="BtnClipboardOpen_Click" Margin="0,0,8,0"/>
                                        <Button Content="{DynamicResource Tools_ClipboardClear}" Style="{StaticResource SecondaryButton}" Click="BtnClipboardClear_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ==================== HOTKEYS ==================== -->
                    <StackPanel x:Name="PanelHotkeys" Background="Transparent" Visibility="Collapsed">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource Hotkeys_Title}" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="{DynamicResource Hotkeys_Desc}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource Hotkeys_ResetDefaults}" Style="{StaticResource SecondaryButton}" Click="BtnResetHotkeys_Click" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <StackPanel x:Name="HotkeyRowsPanel"/>
                        </Border>

                        <TextBlock Text="{DynamicResource Hotkeys_RequireModifier}" Style="{StaticResource MutedText}" Margin="2,10,0,0"/>
                    </StackPanel>

                    <!-- ==================== SETTINGS & ABOUT ==================== -->
                    <StackPanel x:Name="PanelGeneral" Background="Transparent" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Nav_General}" Style="{StaticResource PageTitle}" FontSize="20"/>
                        <TextBlock Text="{DynamicResource General_Subtitle}" Style="{StaticResource BodyText}" Margin="0,2,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Appearance, Behaviour & Captures Workspace -->
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource CardBorder}" Padding="12,11" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource General_Appearance}" Style="{StaticResource SectionTitle}" Margin="0,0,0,9"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="128"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource General_Theme}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="CmbTheme" Style="{StaticResource CryoComboBox}" SelectionChanged="CmbTheme_SelectionChanged" AutomationProperties.Name="{DynamicResource General_Theme}">
                                                <ComboBoxItem Content="{DynamicResource General_ThemeDark}" Tag="Dark"/>
                                                <ComboBoxItem Content="{DynamicResource General_ThemeLight}" Tag="Light"/>
                                                <ComboBoxItem Content="{DynamicResource General_ThemeSystem}" Tag="System"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="128"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource General_Language}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="CmbLanguage" Style="{StaticResource CryoComboBox}" SelectionChanged="CmbLanguage_SelectionChanged" AutomationProperties.Name="{DynamicResource General_Language}">
                                                <ComboBoxItem Content="English" Tag="English"/>
                                                <ComboBoxItem Content="العربية" Tag="العربية"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="128"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource General_TrayClick}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="CmbTrayClick" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource General_TrayClick}">
                                                <ComboBoxItem Content="{DynamicResource General_TrayDashboard}" Tag="Dashboard"/>
                                                <ComboBoxItem Content="{DynamicResource General_TrayCapture}" Tag="Capture"/>
                                            </ComboBox>
                                        </Grid>

                                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,9"/>

                                        <TextBlock Text="{DynamicResource General_PrefsTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkStartWithWindows" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource General_Startup}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <TextBlock Text="{DynamicResource General_StartupDesc}" Style="{StaticResource MutedText}" Margin="22,2,0,7"/>
                                        <CheckBox x:Name="ChkLaunchBackground" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource General_Background}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <CheckBox x:Name="ChkNotifications" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource General_Notifications}" Margin="0,7,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Padding="12,11">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource General_WorkspaceTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                                        <CheckBox x:Name="ChkPinnedFrame" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource General_PinnedFrame}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <CheckBox x:Name="ChkPinnedSound" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource General_PinnedSound}" Margin="0,7,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <CheckBox x:Name="ChkContextMenu" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource General_ContextMenuTitle}" Margin="0,7,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <TextBlock Text="{DynamicResource General_ContextMenuDesc}" Style="{StaticResource MutedText}" Margin="22,2,0,9"/>

                                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,9"/>

                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource General_SavedLimit}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtSavedLimit"
                                                     Grid.Column="1"
                                                     Style="{StaticResource CryoTextBox}"
                                                     Width="78" Height="30"
                                                     Padding="6,2"
                                                     Text="50"
                                                     MaxLength="4"
                                                     FlowDirection="LeftToRight"
                                                     TextAlignment="Center"
                                                     LostFocus="TxtSavedLimit_LostFocus"
                                                     AutomationProperties.Name="{DynamicResource General_SavedLimit}"/>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource General_SavedLimitDesc}" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right Column: CryoUtils Identity + Updates + Settings File -->
                            <StackPanel Grid.Column="2">
                                <Border x:Name="PanelAbout" Style="{StaticResource CardBorder}" Padding="12,11" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Compact Cryo-Family App Header -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="6"
                                                    Background="{DynamicResource InsetBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    Padding="4"
                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Image Source="pack://application:,,,/Images/CryoUtils-Icon.png"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource App_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14.5" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtAboutVersion" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource App_Creator}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="ZerroDevs/CryoUtils" Style="{StaticResource LinkButton}" Click="BtnRepo_Click" FontFamily="{StaticResource CryoMono}" FontSize="10.5" VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Text="{DynamicResource About_Privacy}" Style="{StaticResource MutedText}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{DynamicResource App_Copyright}" Style="{StaticResource MutedText}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>

                                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,9,0,9"/>

                                        <!-- Updates -->
                                        <TextBlock Text="{DynamicResource About_Updates}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{DynamicResource About_UpdatesDesc}" Style="{StaticResource MutedText}" Margin="0,3,0,7"/>
                                        <CheckBox x:Name="ChkAutoUpdates" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource About_Automatic}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <CheckBox x:Name="ChkSaveRollback" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource About_Rollback}" Margin="0,7,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <TextBlock Text="{DynamicResource About_RollbackDesc}" Style="{StaticResource MutedText}" Margin="22,2,0,0"/>

                                        <Border Style="{StaticResource InsetBorder}" Margin="0,8,0,0" Padding="9,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock x:Name="TxtUpdateStatus" Text="{DynamicResource About_Never}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                                    <TextBlock x:Name="TxtLastChecked" Text="{DynamicResource About_Never}" Style="{StaticResource MutedText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="BtnCheckUpdates" Content="{DynamicResource About_Check}" Style="{StaticResource SecondaryButton}" Click="BtnCheckUpdates_Click"/>
                                                    <Button x:Name="BtnDownloadUpdate" Content="{DynamicResource About_Download}" Style="{StaticResource PrimaryButton}" Click="BtnDownloadUpdate_Click" Margin="6,0,0,0" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderStrongBrush}" BorderThickness="0"/>
                                        <Border x:Name="UpdateNotesPanel" Style="{StaticResource InsetBorder}" Margin="0,6,0,0" Visibility="Collapsed" MaxHeight="90">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="TxtUpdateNotes" Style="{StaticResource MutedText}"/>
                                            </ScrollViewer>
                                        </Border>

                                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,9,0,8"/>

                                        <!-- Rollback Backup -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{DynamicResource About_Restore}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtRollbackStatus" Text="{DynamicResource About_NoBackup}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnRestore" Content="{DynamicResource About_Restore}" Style="{StaticResource SecondaryButton}" Click="BtnRestore_Click" IsEnabled="False" Margin="0,0,6,0"/>
                                                <Button x:Name="BtnDeleteBackup" Content="{DynamicResource About_DeleteBackup}" Style="{StaticResource DangerButton}" Click="BtnDeleteBackup_Click" IsEnabled="False"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Settings File Export / Import / Reset -->
                                <Border Style="{StaticResource CardBorder}" Padding="12,11">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource General_DataTitle}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{DynamicResource General_DataDesc}" Style="{StaticResource MutedText}" Margin="0,3,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource General_Export}" Style="{StaticResource SecondaryButton}" Click="BtnExportSettings_Click" Margin="0,0,7,0"/>
                                            <Button Content="{DynamicResource General_Import}" Style="{StaticResource SecondaryButton}" Click="BtnImportSettings_Click" Margin="0,0,7,0"/>
                                            <Button Content="{DynamicResource General_Reset}" Style="{StaticResource DangerButton}" Click="BtnResetSettings_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Row 3: Status Bar -->
            <Grid Grid.Row="3" Margin="18,0,18,0">
                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Top"/>
                <TextBlock x:Name="TxtStatusBar"
                           Text="{DynamicResource About_Privacy}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtStatusVersion"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="{StaticResource CryoMono}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FlowDirection="LeftToRight"/>
            </Grid>
        </Grid>
    </Border>
</Window>
