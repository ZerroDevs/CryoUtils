<Window x:Class="CryoUtils.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CryoUtils.Views"
        Title="{DynamicResource App_Title}"
        Width="1080" Height="750"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SegoeUIVariableText}"
        Icon="pack://application:,,,/Images/CryoUtils.ico"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Modern Custom Titlebar -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Identity & Version Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="24" Height="24" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,9,0">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource AccentBrush}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{DynamicResource App_Title}"
                               Foreground="{DynamicResource TextTitleBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="2" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitleVersion"
                                   Text=""
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="{StaticResource CryoMono}"
                                   FontSize="9.5"
                                   FlowDirection="LeftToRight"/>
                    </Border>
                </StackPanel>

                <!-- Right: Quick Actions & Minimize / Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Style="{StaticResource HotkeyPill}" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderHotkey"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontFamily="{StaticResource CryoMono}"
                                   FontSize="10"
                                   FlowDirection="LeftToRight"/>
                    </Border>
                    <Button Content="{DynamicResource Main_CaptureNow}"
                            Style="{StaticResource PrimaryButton}"
                            Height="28"
                            Padding="12,0"
                            FontSize="11"
                            VerticalContentAlignment="Center"
                            Click="BtnHeroCapture_Click"
                            Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Main_RecordNow}"
                            Style="{StaticResource SecondaryButton}"
                            Height="28"
                            Padding="12,0"
                            FontSize="11"
                            VerticalContentAlignment="Center"
                            Click="BtnRecordNow_Click"
                            Margin="0,0,10,0"/>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource DividerBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnQuit"
                            Style="{StaticResource TitleActionBtn}"
                            Click="BtnQuit_Click"
                            Margin="0,0,4,0"
                            ToolTip="{DynamicResource Main_TooltipQuit}"
                            AutomationProperties.Name="{DynamicResource Main_TooltipQuit}">
                        <Path x:Name="PathQuitIcon"
                              Data="{x:Static views:IconData.Power}"
                              Stroke="{DynamicResource IconBrush}"
                              StrokeThickness="1.5"
                              Width="13" Height="13"
                              Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource TitleActionBtn}"
                            Click="BtnClose_Click"
                            ToolTip="{DynamicResource Main_TooltipMinimize}"
                            AutomationProperties.Name="{DynamicResource Main_TooltipMinimize}">
                        <Path Data="{x:Static views:IconData.Close}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Main Body with Left Sidebar (Col 0) and Content Area (Col 1) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarCol" Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 0: Collapsible Navigation Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Hamburger / Collapse Toggle -->
                        <Border Grid.Row="0" Height="40" Padding="4,4,4,0" VerticalAlignment="Center">
                            <Button x:Name="BtnToggleSidebar"
                                    Style="{StaticResource TitleActionBtn}"
                                    Width="44" Height="34"
                                    HorizontalAlignment="Left"
                                    Focusable="False"
                                    FocusVisualStyle="{x:Null}"
                                    Click="BtnToggleSidebar_Click"
                                    ToolTip="Toggle sidebar"
                                    AutomationProperties.Name="Toggle sidebar">
                                <Path Data="{x:Static views:IconData.Menu}"
                                      Stroke="{DynamicResource IconBrush}"
                                      StrokeThickness="1.5"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Button>
                        </Border>

                        <!-- Row 1: Top Navigation (Core Tools) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,4,4,6">
                                <TextBlock x:Name="TxtNavGroupCore"
                                           Text="{DynamicResource Nav_CoreGroup}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="14,2,14,6"/>

                                <RadioButton x:Name="TabOverview"
                                             Style="{StaticResource SidebarTabStyle}"
                                             Tag="Overview"
                                             IsChecked="True"
                                             Checked="Tab_Checked"
                                             ToolTip="{DynamicResource Nav_Overview}">
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0"
                                              Data="{x:Static views:IconData.Home}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.4"
                                              Width="16" Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="TxtNavOverview"
                                                   Text="{DynamicResource Nav_Overview}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                    </Grid>
                                </RadioButton>

                                <RadioButton x:Name="TabCapture"
                                             Style="{StaticResource SidebarTabStyle}"
                                             Tag="Capture"
                                             Checked="Tab_Checked"
                                             ToolTip="{DynamicResource Nav_Capture}">
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0"
                                              Data="{x:Static views:IconData.Capture}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.4"
                                              Width="16" Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="TxtNavCapture"
                                                   Text="{DynamicResource Nav_Capture}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                    </Grid>
                                </RadioButton>

                                <RadioButton x:Name="TabTools"
                                             Style="{StaticResource SidebarTabStyle}"
                                             Tag="Tools"
                                             Checked="Tab_Checked"
                                             ToolTip="{DynamicResource Nav_Tools}">
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0"
                                              Data="{x:Static views:IconData.Tools}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.4"
                                              Width="16" Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="TxtNavTools"
                                                   Text="{DynamicResource Nav_Tools}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                    </Grid>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Row 2: Bottom Navigation (Hotkeys & Settings) -->
                        <Border Grid.Row="2" Padding="4,6,4,10">
                            <StackPanel>
                                <Rectangle x:Name="SidebarDivider" Height="1" Fill="{DynamicResource DividerBrush}" Margin="6,0,6,8"/>

                                <RadioButton x:Name="TabHotkeys"
                                             Style="{StaticResource SidebarTabStyle}"
                                             Tag="Hotkeys"
                                             Checked="Tab_Checked"
                                             ToolTip="{DynamicResource Nav_Hotkeys}">
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0"
                                              Data="{x:Static views:IconData.Keyboard}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.4"
                                              Width="16" Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="TxtNavHotkeys"
                                                   Text="{DynamicResource Nav_Hotkeys}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                    </Grid>
                                </RadioButton>

                                <RadioButton x:Name="TabGeneral"
                                             Style="{StaticResource SidebarTabStyle}"
                                             Tag="General"
                                             Checked="Tab_Checked"
                                             ToolTip="{DynamicResource Nav_General}">
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0"
                                              Data="{x:Static views:IconData.Settings}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.4"
                                              Width="16" Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="TxtNavGeneral"
                                                   Text="{DynamicResource Nav_General}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                    </Grid>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Column 1: Right Content Area -->
                <ScrollViewer Grid.Column="1" Style="{StaticResource CryoScrollViewer}" Padding="24,20,24,24">
                    <Grid>
                        <!-- ==================== OVERVIEW ==================== -->
                        <StackPanel x:Name="PanelOverview">
                            <!-- Header & live module count -->
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Main_OverviewTitle}" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="{DynamicResource Main_OverviewSubtitle}" Style="{StaticResource BodyText}" Margin="0,5,0,0" MaxWidth="600" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Border Style="{StaticResource HotkeyPill}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock x:Name="TxtModuleCount" Foreground="{DynamicResource AccentTextBrush}" FontSize="11"/>
                                </Border>
                            </Grid>

                            <!-- Quick Action Hero Bar (4 Tiles) -->
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tile 1: Capture -->
                                <Button Grid.Column="0" Style="{StaticResource QuickTileButton}" Click="BtnHeroCapture_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Path Data="{x:Static views:IconData.Capture}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Main_CaptureNow}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="F10 · Screen" Foreground="{DynamicResource AccentTextBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Tile 2: Record GIF -->
                                <Button Grid.Column="2" Style="{StaticResource QuickTileButton}" Click="BtnRecordNow_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Path Data="{x:Static views:IconData.Record}" Stroke="{DynamicResource DangerTextBrush}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Main_RecordNow}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="GIF / MP4" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Tile 3: Colour Picker -->
                                <Button Grid.Column="4" Style="{StaticResource QuickTileButton}" Click="BtnQuickColor_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Path Data="{x:Static views:IconData.Droplet}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Module_ColorName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Ctrl+Shift+C" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Tile 4: QR Suite -->
                                <Button Grid.Column="6" Style="{StaticResource QuickTileButton}" Click="BtnGoQr_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Path Data="{x:Static views:IconData.QrCode}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Tools_QrTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Scan &amp; Make" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- Recent Captures Section (Front & Center) -->
                            <Border Margin="0,20,0,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="16,14">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Recent_Title}" Style="{StaticResource SectionTitle}" FontSize="13.5"/>
                                            <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="2" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
                                                <TextBlock Text="Session" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" FontFamily="{StaticResource CryoMono}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Content="{DynamicResource Recent_OpenFolder}" Style="{StaticResource LinkButton}" Click="RecentOpenFolder_Click" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                    </Grid>

                                    <!-- Empty state -->
                                    <Border x:Name="RecentEmpty" Style="{StaticResource InsetBorder}" Margin="0,12,0,0" Padding="20,18">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{x:Static views:IconData.Capture}" Stroke="{DynamicResource ModuleMutedBrush}" StrokeThickness="1.4" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Recent_Empty}" Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Items wrap panel -->
                                    <ItemsControl x:Name="RecentItems" Margin="0,12,0,0" Visibility="Collapsed">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource CardBorder}" Width="182" Margin="0,0,10,10" Padding="8" Background="{DynamicResource InsetBackgroundBrush}">
                                                    <StackPanel>
                                                        <!-- Clickable thumbnail with hover pencil badge to edit in screenshot mode -->
                                                        <Border Height="86"
                                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Cursor="Hand"
                                                                ClipToBounds="True"
                                                                Tag="{Binding}"
                                                                MouseLeftButtonUp="RecentThumbnail_Click"
                                                                ToolTip="{DynamicResource Recent_EditTip}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

                                                                <!-- Hover overlay with pencil icon -->
                                                                <Border Background="#75080C10" Cursor="Hand">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Opacity" Value="0"/>
                                                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                                                                                    <Setter Property="Opacity" Value="1"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Border Width="28" Height="28"
                                                                            CornerRadius="14"
                                                                            Background="{DynamicResource AccentButtonBrush}"
                                                                            BorderBrush="{DynamicResource AccentButtonBrush}"
                                                                            BorderThickness="1"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                                        <Path Data="{x:Static views:IconData.Edit}"
                                                                              Stroke="{DynamicResource AccentButtonTextBrush}"
                                                                              StrokeThickness="1.3"
                                                                              Width="13" Height="13"
                                                                              Stretch="Uniform"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                                        <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource CryoMono}" FontSize="9.5" Margin="0,2,0,6"/>

                                                        <!-- Copy button is the biggest (primary action) -->
                                                        <Button Content="{DynamicResource Recent_Copy}" Tag="{Binding}" Click="RecentCopy_Click" Style="{StaticResource PrimaryButton}" Height="27" Padding="0" FontSize="10.5" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,0,5"/>

                                                        <!-- Action row: Compress small, Folder icon, Trash icon -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="26"/>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="26"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Compress button (small) -->
                                                            <Button Grid.Column="0" Content="{DynamicResource Recent_Compress}" Tag="{Binding}" Click="RecentCompress_Click" Style="{StaticResource SecondaryButton}" Height="24" FontSize="9.5" Padding="4,1" ToolTip="{DynamicResource Recent_Compress}"/>

                                                            <!-- Folder icon (open folder) -->
                                                            <Button Grid.Column="2" Tag="{Binding}" Click="RecentOpenFolder_Click" Style="{StaticResource SecondaryButton}" Width="26" Height="24" Padding="0" ToolTip="{DynamicResource Recent_OpenFolder}">
                                                                <Path Data="{x:Static views:IconData.Folder}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>

                                                            <!-- Trash can / Confirm delete icon -->
                                                            <Button Grid.Column="4" Tag="{Binding}" Click="RecentDelete_Click" Style="{StaticResource SecondaryButton}" Width="26" Height="24" Padding="0" Background="{Binding DeleteBackground}" BorderBrush="{Binding DeleteBorderBrush}" ToolTip="{Binding DeleteToolTip}">
                                                                <Path Data="{Binding DeleteIcon}" Stroke="{Binding DeleteIconBrush}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Active Modules Control Grid -->
                            <StackPanel Margin="0,22,0,0">
                                <TextBlock Text="{DynamicResource Main_OverviewTitle}" Style="{StaticResource SectionTitle}" FontSize="13.5"/>
                                <TextBlock Text="{DynamicResource Main_OverviewSubtitle}" Style="{StaticResource MutedText}" Margin="0,3,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 1. Screen Capture & Annotation -->
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,10,0">
                                                        <Path Data="{x:Static views:IconData.Capture}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{DynamicResource Module_CaptureName}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ToggleButton x:Name="ChkModuleCapture" Style="{StaticResource ToggleSwitch}" Tag="Capture" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" AutomationProperties.Name="{DynamicResource Module_CaptureName}"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{DynamicResource Module_CaptureDesc}" Style="{StaticResource MutedText}" Margin="0,10,0,14"/>
                                            <Grid Grid.Row="2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource HotkeyPill}">
                                                        <TextBlock x:Name="TxtHotkeyCapture" FontFamily="{StaticResource CryoMono}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FlowDirection="LeftToRight"/>
                                                    </Border>
                                                    <Button Content="{DynamicResource Module_QuickLaunch}" Style="{StaticResource SecondaryButton}" Click="BtnQuickCapture_Click" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <Button Content="{DynamicResource Recent_Compress}" Style="{StaticResource LinkButton}" Click="BtnGoCompress_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- 2. Precision Colour Picker -->
                                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorder}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,10,0">
                                                        <Path Data="{x:Static views:IconData.Droplet}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{DynamicResource Module_ColorName}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ToggleButton x:Name="ChkModuleColor" Style="{StaticResource ToggleSwitch}" Tag="Color" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" AutomationProperties.Name="{DynamicResource Module_ColorName}"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{DynamicResource Module_ColorDesc}" Style="{StaticResource MutedText}" Margin="0,10,0,14"/>
                                            <Grid Grid.Row="2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource HotkeyPill}">
                                                        <TextBlock x:Name="TxtHotkeyColor" FontFamily="{StaticResource CryoMono}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FlowDirection="LeftToRight"/>
                                                    </Border>
                                                    <Button Content="{DynamicResource Module_QuickLaunch}" Style="{StaticResource SecondaryButton}" Click="BtnQuickColor_Click" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- 3. Always on Top -->
                                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorder}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,10,0">
                                                        <Path Data="{x:Static views:IconData.Pin}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{DynamicResource Module_PinnerName}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ToggleButton x:Name="ChkModulePinner" Style="{StaticResource ToggleSwitch}" Tag="Pinner" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" AutomationProperties.Name="{DynamicResource Module_PinnerName}"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtOverviewPinnedStatus" Grid.Row="1" Text="{DynamicResource Module_PinnerDesc}" Style="{StaticResource MutedText}" Margin="0,10,0,14" TextTrimming="CharacterEllipsis"/>
                                            <Grid Grid.Row="2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource HotkeyPill}">
                                                        <TextBlock x:Name="TxtHotkeyPinner" FontFamily="{StaticResource CryoMono}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FlowDirection="LeftToRight"/>
                                                    </Border>
                                                    <Button Content="{DynamicResource Module_QuickLaunch}" Style="{StaticResource SecondaryButton}" Click="BtnQuickPinner_Click" Margin="8,0,0,0"/>
                                                    <Button x:Name="BtnOverviewUnpin" Content="{DynamicResource Tools_Unpin}" Style="{StaticResource DangerButton}" Click="BtnUnpin_Click" Margin="6,0,0,0" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- 4. Image and GIF Compressor -->
                                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,10,0">
                                                        <Path Data="{x:Static views:IconData.Compress}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{DynamicResource Module_CompressorName}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ToggleButton x:Name="ChkModuleCompressor" Style="{StaticResource ToggleSwitch}" Tag="Compressor" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" AutomationProperties.Name="{DynamicResource Module_CompressorName}"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{DynamicResource Module_CompressorDesc}" Style="{StaticResource MutedText}" Margin="0,10,0,14"/>
                                            <Grid Grid.Row="2">
                                                <Button Content="{DynamicResource Module_QuickLaunch}" Style="{StaticResource SecondaryButton}" Click="BtnGoCompress_Click" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- 5. Plain Paste & Clipboard History -->
                                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource CardBorder}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,10,0">
                                                        <Path Data="{x:Static views:IconData.Clipboard}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{DynamicResource Module_ClipboardName}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ToggleButton x:Name="ChkModuleClipboard" Style="{StaticResource ToggleSwitch}" Tag="Clipboard" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" AutomationProperties.Name="{DynamicResource Module_ClipboardName}"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{DynamicResource Module_ClipboardDesc}" Style="{StaticResource MutedText}" Margin="0,10,0,14"/>
                                            <Grid Grid.Row="2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource HotkeyPill}">
                                                        <TextBlock x:Name="TxtHotkeyClipboard" FontFamily="{StaticResource CryoMono}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FlowDirection="LeftToRight"/>
                                                    </Border>
                                                    <Button Content="{DynamicResource Module_QuickLaunch}" Style="{StaticResource SecondaryButton}" Click="BtnQuickClipboard_Click" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- 6. QR Code Suite -->
                                    <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource CardBorder}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,10,0">
                                                        <Path Data="{x:Static views:IconData.QrCode}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{DynamicResource Tools_QrTitle}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Padding="6,2" CornerRadius="3" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="NEW" Foreground="{DynamicResource AccentTextBrush}" FontFamily="{StaticResource CryoMono}" FontSize="9.5" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{DynamicResource Tools_QrDesc}" Style="{StaticResource MutedText}" Margin="0,10,0,14"/>
                                            <Grid Grid.Row="2">
                                                <Button Content="{DynamicResource Module_QuickLaunch}" Style="{StaticResource SecondaryButton}" Click="BtnGoQr_Click" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- ==================== CAPTURE ==================== -->
                    <StackPanel x:Name="PanelCapture" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Nav_Capture}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{DynamicResource Capture_RecordHint}" Style="{StaticResource BodyText}" Margin="0,5,0,16"/>

                        <Border x:Name="PrintScreenBanner" Style="{StaticResource InsetBorder}" BorderBrush="{DynamicResource WarningTextBrush}" Visibility="Collapsed" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Capture_Contested}" Foreground="{DynamicResource WarningTextBrush}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{DynamicResource Capture_UseFallback}" Style="{StaticResource SecondaryButton}" Click="BtnUseFallback_Click" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Capture_SettingsTitle}" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox x:Name="ChkQuickSave" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_QuickSave}" Margin="0,12,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <TextBlock Text="{DynamicResource Capture_QuickSaveDesc}" Style="{StaticResource MutedText}" Margin="22,3,0,0"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Capture_Delay}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                                        <ComboBox x:Name="CmbCaptureDelay" Grid.Column="1" Width="110" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Capture_Delay}">
                                            <ComboBoxItem Content="{DynamicResource Capture_DelayInstant}" Tag="0"/>
                                            <ComboBoxItem Content="{DynamicResource Capture_Delay3s}" Tag="3"/>
                                            <ComboBoxItem Content="{DynamicResource Capture_Delay5s}" Tag="5"/>
                                            <ComboBoxItem Content="{DynamicResource Capture_Delay10s}" Tag="10"/>
                                        </ComboBox>
                                    </Grid>

                                    <TextBlock Text="{DynamicResource Capture_Folder}" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSaveFolder" Style="{StaticResource CryoTextBox}" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="{DynamicResource Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BtnBrowseFolder_Click" Margin="6,0,0,0"/>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Capture_ImageFormat}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                                        <ComboBox x:Name="CmbImageFormat" Grid.Column="1" Width="110" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Capture_ImageFormat}">
                                            <ComboBoxItem Content="PNG" Tag="PNG"/>
                                            <ComboBoxItem Content="JPG" Tag="JPG"/>
                                            <ComboBoxItem Content="WEBP" Tag="WEBP"/>
                                        </ComboBox>
                                    </Grid>

                                    <CheckBox x:Name="ChkAutoCopy" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_AutoCopy}" Margin="0,12,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <CheckBox x:Name="ChkCaptureSound" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_Sound}" Margin="0,9,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <CheckBox x:Name="ChkShowLoupe" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_Loupe}" Margin="0,9,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <TextBlock Text="{DynamicResource Capture_LoupeDesc}" Style="{StaticResource MutedText}" Margin="22,3,0,0"/>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Capture_DefaultColor}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                                        <Button x:Name="BtnDefaultColor" Grid.Column="1" Width="78" Height="28" Style="{StaticResource SecondaryButton}" Padding="4,2" Click="BtnDefaultColor_Click" AutomationProperties.Name="{DynamicResource Capture_DefaultColor}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="DefaultColorSwatch" Width="14" Height="14" CornerRadius="2" Background="#E5534B" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                                                <TextBlock x:Name="TxtDefaultColor" Margin="6,0,0,0" FontFamily="{StaticResource CryoMono}" FontSize="9.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Capture_Thickness}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Slider x:Name="SldThickness" Style="{StaticResource CryoSlider}" Width="120" Minimum="1" Maximum="20" Value="3" ValueChanged="Thickness_ValueChanged" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                            <TextBlock x:Name="TxtThickness" Width="34" Text="3" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" FlowDirection="LeftToRight" VerticalAlignment="Center" TextAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Capture_StepStart}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                                        <TextBox x:Name="TxtStepStart" Grid.Column="1" Width="70" Style="{StaticResource CryoTextBox}" Text="1" FlowDirection="LeftToRight" LostFocus="TxtStepStart_LostFocus" AutomationProperties.Name="{DynamicResource Capture_StepStart}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Capture_GifTitle}" Style="{StaticResource SectionTitle}"/>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Capture_Fps}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                                            <ComboBox x:Name="CmbFps" Grid.Column="1" Width="98" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Capture_Fps}">
                                                <ComboBoxItem Content="15" Tag="15"/>
                                                <ComboBoxItem Content="24" Tag="24"/>
                                                <ComboBoxItem Content="30" Tag="30"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Capture_Format}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                                            <ComboBox x:Name="CmbRecFormat" Grid.Column="1" Width="98" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Capture_Format}">
                                                <ComboBoxItem Content="GIF" Tag="GIF"/>
                                                <ComboBoxItem Content="MP4" Tag="MP4"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Capture_MaxSeconds}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                                            <ComboBox x:Name="CmbMaxSeconds" Grid.Column="1" Width="98" Style="{StaticResource CryoComboBox}" SelectionChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource Capture_MaxSeconds}">
                                                <ComboBoxItem Content="10" Tag="10"/>
                                                <ComboBoxItem Content="20" Tag="20"/>
                                                <ComboBoxItem Content="30" Tag="30"/>
                                                <ComboBoxItem Content="60" Tag="60"/>
                                            </ComboBox>
                                        </Grid>
                                        <CheckBox x:Name="ChkCopyOnStop" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Capture_CopyOnStop}" Margin="0,12,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,12,0,10"/>
                                        <TextBlock Text="{DynamicResource Capture_OcrNote}" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Main_HeroKicker}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{DynamicResource Capture_RecordHint}" Style="{StaticResource MutedText}" Margin="0,6,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Main_CaptureNow}" Style="{StaticResource PrimaryButton}" Click="BtnHeroCapture_Click" Margin="0,0,8,0"/>
                                            <Button Content="{DynamicResource Main_RecordNow}" Style="{StaticResource SecondaryButton}" Click="BtnRecordNow_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ==================== TOOLS ==================== -->
                    <StackPanel x:Name="PanelTools" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Nav_Tools}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{DynamicResource Tools_CompressorDesc}" Style="{StaticResource BodyText}" Margin="0,5,0,16"/>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Tools_CompressorTitle}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{DynamicResource Tools_NoResult}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BtnBrowseCompress_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="300"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="DropZone" Grid.Column="0" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="18" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop" MouseLeftButtonDown="DropZone_MouseLeftButtonDown" Cursor="Hand">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{x:Static views:IconData.Compress}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCompressFileName" Text="{DynamicResource Tools_Dropzone}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                            <TextBlock Text="{DynamicResource Tools_DropzoneHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Tools_Preset}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbPreset" Style="{StaticResource CryoComboBox}" SelectionChanged="CmbPreset_SelectionChanged" AutomationProperties.Name="{DynamicResource Tools_Preset}">
                                            <ComboBoxItem Content="{DynamicResource Tools_PresetDiscord}" Tag="Discord"/>
                                            <ComboBoxItem Content="{DynamicResource Tools_PresetWhatsApp}" Tag="WhatsApp"/>
                                            <ComboBoxItem Content="{DynamicResource Tools_PresetCustom}" Tag="Custom"/>
                                        </ComboBox>

                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Text="{DynamicResource Tools_Quality}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtQualityValue" Text="82%" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" FlowDirection="LeftToRight"/>
                                        </Grid>
                                        <Slider x:Name="SldQuality" Style="{StaticResource CryoSlider}" Minimum="20" Maximum="100" Value="82" ValueChanged="Compression_ValueChanged" IsSnapToTickEnabled="True" TickFrequency="1"/>

                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="{DynamicResource Tools_Scale}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtScaleValue" Text="100%" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" FlowDirection="LeftToRight"/>
                                        </Grid>
                                        <Slider x:Name="SldScale" Style="{StaticResource CryoSlider}" Minimum="20" Maximum="100" Value="100" ValueChanged="Compression_ValueChanged" IsSnapToTickEnabled="True" TickFrequency="5"/>

                                        <Button x:Name="BtnCompress" Content="{DynamicResource Tools_CompressButton}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="BtnCompress_Click" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource InsetBorder}" Padding="10,8" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtCompressStatus" Text="{DynamicResource Tools_NoResult}" Style="{StaticResource MutedText}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{DynamicResource Tools_Before}" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtBeforeSize" Text="--" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" FlowDirection="LeftToRight"/>
                                                <TextBlock Text="{DynamicResource Tools_After}" Style="{StaticResource FieldLabel}" Margin="16,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtAfterSize" Text="--" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" FlowDirection="LeftToRight"/>
                                                <TextBlock Text="{DynamicResource Tools_Saved}" Style="{StaticResource FieldLabel}" Margin="16,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtSaved" Text="--" Foreground="{DynamicResource AccentTextBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" FlowDirection="LeftToRight"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="96" Height="62" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,10,0">
                                            <Image x:Name="ImgCompressedPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <Button x:Name="BtnSaveCompressed" Content="{DynamicResource Tools_SaveAs}" Style="{StaticResource SecondaryButton}" Click="BtnSaveCompressed_Click" IsEnabled="False" Margin="0,0,7,0"/>
                                        <Button x:Name="BtnCopyCompressed" Content="{DynamicResource Tools_CopyFile}" Style="{StaticResource SecondaryButton}" Click="BtnCopyCompressed_Click" IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Tools_RecentColors}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="TxtRecentColorsEmpty" Text="{DynamicResource Tools_RecentColorsEmpty}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                                    <WrapPanel x:Name="RecentColorsPanel" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Tools_PinnedTitle}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="TxtPinnedWindow" Text="{DynamicResource Tools_PinnedNone}" Style="{StaticResource MutedText}" Margin="0,6,0,10" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnUnpin" Content="{DynamicResource Tools_Unpin}" Style="{StaticResource SecondaryButton}" Click="BtnUnpin_Click" HorizontalAlignment="Left" IsEnabled="False"/>
                                        <Button x:Name="BtnResetPinner" Content="{DynamicResource Tools_ResetPinner}" Style="{StaticResource DangerButton}" Click="BtnResetPinner_Click" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="{DynamicResource Tools_PinnedOpacity}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtPinnedOpacity" Text="100%" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10" FlowDirection="LeftToRight"/>
                                    </Grid>
                                    <Slider x:Name="SldPinnedOpacity" Style="{StaticResource CryoSlider}" Minimum="20" Maximum="100" Value="100" ValueChanged="PinnedOpacity_ValueChanged" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                    <CheckBox x:Name="ChkPinnedClickThrough" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource Tools_PinnedClickThrough}" Margin="0,8,0,0" Checked="PinnedClickThrough_Changed" Unchecked="PinnedClickThrough_Changed"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Tools_ClipboardTitle}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="TxtClipboardCount" Text="{DynamicResource Tools_ClipboardEmpty}" Style="{StaticResource MutedText}" Margin="0,6,0,4"/>
                                    <TextBlock x:Name="TxtClipboardNote" Text="{DynamicResource Tools_ClipboardDesc}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{DynamicResource Tools_ClipboardOpen}" Style="{StaticResource SecondaryButton}" Click="BtnClipboardOpen_Click" Margin="0,0,7,0"/>
                                        <Button Content="{DynamicResource Tools_ClipboardClear}" Style="{StaticResource SecondaryButton}" Click="BtnClipboardClear_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Contrast Checker and QR Code Tools -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Contrast Checker Card -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{x:Static views:IconData.Contrast}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/>
                                            <TextBlock Text="{DynamicResource Tools_ContrastTitle}" Style="{StaticResource CardTitle}" Margin="9,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Tools_ContrastDesc}" Style="{StaticResource MutedText}" Margin="0,7,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Tools_ColorA}" Style="{StaticResource FieldLabel}"/>
                                            <Grid>
                                                <TextBox x:Name="TxtContrastA" Style="{StaticResource CryoTextBox}" Text="#FFFFFF" FontFamily="{StaticResource CryoMono}" Height="28" Padding="28,4,4,4" TextChanged="ContrastColor_TextChanged" AutomationProperties.Name="{DynamicResource Tools_ColorA}"/>
                                                <Border x:Name="SwatchContrastA" Width="16" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Background="#FFFFFF" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                                            </Grid>
                                        </StackPanel>

                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="8,16,8,0" Click="BtnSwapContrastColors_Click" ToolTip="Swap" AutomationProperties.Name="Swap" VerticalAlignment="Center">
                                            <Path Data="M4,8 L14,8 M11,5 L14,8 L11,11 M14,14 L4,14 M7,11 L4,14 L7,17" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform"/>
                                        </Button>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Tools_ColorB}" Style="{StaticResource FieldLabel}"/>
                                            <Grid>
                                                <TextBox x:Name="TxtContrastB" Style="{StaticResource CryoTextBox}" Text="#0E7C6C" FontFamily="{StaticResource CryoMono}" Height="28" Padding="28,4,4,4" TextChanged="ContrastColor_TextChanged" AutomationProperties.Name="{DynamicResource Tools_ColorB}"/>
                                                <Border x:Name="SwatchContrastB" Width="16" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Background="#0E7C6C" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Live Contrast Result Box -->
                                    <Border Margin="0,14,0,0" Padding="12,10" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Tools_ContrastRatio}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                                <TextBlock x:Name="TxtDashboardContrastRatio" Text="4.61:1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="18" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{DynamicResource Tools_WcagAa}" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <Border x:Name="BadgeWcagAaNormal" Padding="5,1" CornerRadius="2" Background="{DynamicResource SuccessMutedBrush}" Margin="0,0,4,0">
                                                        <TextBlock x:Name="TxtWcagAaNormal" Text="Normal: Pass" Foreground="{DynamicResource SuccessBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border x:Name="BadgeWcagAaLarge" Padding="5,1" CornerRadius="2" Background="{DynamicResource SuccessMutedBrush}">
                                                        <TextBlock x:Name="TxtWcagAaLarge" Text="Large: Pass" Foreground="{DynamicResource SuccessBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource Tools_WcagAaa}" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <Border x:Name="BadgeWcagAaaNormal" Padding="5,1" CornerRadius="2" Background="{DynamicResource InsetBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,4,0">
                                                        <TextBlock x:Name="TxtWcagAaaNormal" Text="Normal: Fail" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border x:Name="BadgeWcagAaaLarge" Padding="5,1" CornerRadius="2" Background="{DynamicResource SuccessMutedBrush}">
                                                        <TextBlock x:Name="TxtWcagAaaLarge" Text="Large: Pass" Foreground="{DynamicResource SuccessBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- QR Code Generator & Scanner Card -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{x:Static views:IconData.QrCode}" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/>
                                            <TextBlock Text="{DynamicResource Tools_QrTitle}" Style="{StaticResource CardTitle}" Margin="9,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="{DynamicResource Tools_QrScanScreen}" Style="{StaticResource SecondaryButton}" Click="BtnQrScanScreen_Click" Margin="0,0,6,0"/>
                                            <Button Content="{DynamicResource Tools_QrScanFile}" Style="{StaticResource SecondaryButton}" Click="BtnQrScanFile_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Tools_QrDesc}" Style="{StaticResource MutedText}" Margin="0,7,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Tools_QrInput}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtQrInput" Style="{StaticResource CryoTextBox}" Height="54" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="TxtQrInput_TextChanged" AutomationProperties.Name="{DynamicResource Tools_QrInput}"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Width="104" Height="104" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3" VerticalAlignment="Top">
                                            <Image x:Name="ImgQrPreview" Width="96" Height="96" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnCopyQr" Content="{DynamicResource Tools_QrCopy}" Style="{StaticResource SecondaryButton}" Click="BtnCopyQr_Click" IsEnabled="False" Margin="0,0,6,0"/>
                                            <Button x:Name="BtnSaveQr" Content="{DynamicResource Tools_QrSave}" Style="{StaticResource SecondaryButton}" Click="BtnSaveQr_Click" IsEnabled="False"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Tools_QrCorrection}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="CmbQrCorrection" Width="55" Height="26" Style="{StaticResource CryoComboBox}" SelectionChanged="CmbQrCorrection_SelectionChanged" AutomationProperties.Name="{DynamicResource Tools_QrCorrection}">
                                                <ComboBoxItem Content="M" Tag="M" IsSelected="True"/>
                                                <ComboBoxItem Content="L" Tag="L"/>
                                                <ComboBoxItem Content="Q" Tag="Q"/>
                                                <ComboBoxItem Content="H" Tag="H"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ==================== HOTKEYS ==================== -->
                    <StackPanel x:Name="PanelHotkeys" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Hotkeys_Title}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{DynamicResource Hotkeys_Desc}" Style="{StaticResource BodyText}" Margin="0,5,0,16" MaxWidth="720" HorizontalAlignment="Left"/>
                        <Border Style="{StaticResource CardBorder}" Padding="4">
                            <StackPanel x:Name="HotkeyRowsPanel"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{DynamicResource Hotkeys_ResetDefaults}" Style="{StaticResource SecondaryButton}" Click="BtnResetHotkeys_Click"/>
                            <TextBlock Text="{DynamicResource Hotkeys_RequireModifier}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                        <!-- ==================== GENERAL ==================== -->
                    <StackPanel x:Name="PanelGeneral" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Nav_General}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{DynamicResource General_StartupDesc}" Style="{StaticResource BodyText}" Margin="0,5,0,16" MaxWidth="720" HorizontalAlignment="Left"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource General_Appearance}" Style="{StaticResource SectionTitle}"/>
                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="{DynamicResource General_Theme}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbTheme" Width="140" HorizontalAlignment="Right" Style="{StaticResource CryoComboBox}" SelectionChanged="CmbTheme_SelectionChanged" AutomationProperties.Name="{DynamicResource General_Theme}">
                                            <ComboBoxItem Content="{DynamicResource General_ThemeDark}" Tag="Dark"/>
                                            <ComboBoxItem Content="{DynamicResource General_ThemeLight}" Tag="Light"/>
                                            <ComboBoxItem Content="{DynamicResource General_ThemeSystem}" Tag="System"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="{DynamicResource General_Language}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbLanguage" Width="140" HorizontalAlignment="Right" Style="{StaticResource CryoComboBox}" SelectionChanged="CmbLanguage_SelectionChanged" AutomationProperties.Name="{DynamicResource General_Language}">
                                            <ComboBoxItem Content="English" Tag="English"/>
                                            <ComboBoxItem Content="العربية" Tag="العربية" FlowDirection="RightToLeft"/>
                                        </ComboBox>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,14,0,12"/>
                                    <CheckBox x:Name="ChkStartWithWindows" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource General_Startup}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <CheckBox x:Name="ChkLaunchBackground" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource General_Background}" Margin="0,10,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <CheckBox x:Name="ChkNotifications" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource General_Notifications}" Margin="0,10,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource General_TrayClick}" Style="{StaticResource SectionTitle}"/>
                                    <ComboBox x:Name="CmbTrayClick" Style="{StaticResource CryoComboBox}" Margin="0,10,0,0" SelectionChanged="Setting_Changed" AutomationProperties.Name="{DynamicResource General_TrayClick}">
                                        <ComboBoxItem Content="{DynamicResource General_TrayDashboard}" Tag="Dashboard"/>
                                        <ComboBoxItem Content="{DynamicResource General_TrayCapture}" Tag="Capture"/>
                                    </ComboBox>
                                    <CheckBox x:Name="ChkPinnedFrame" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource General_PinnedFrame}" Margin="0,14,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <CheckBox x:Name="ChkPinnedSound" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource General_PinnedSound}" Margin="0,10,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,14,0,12"/>
                                    <TextBlock Text="{DynamicResource General_DataTitle}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{DynamicResource General_DataDesc}" Style="{StaticResource MutedText}" Margin="0,5,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{DynamicResource General_Export}" Style="{StaticResource SecondaryButton}" Click="BtnExportSettings_Click" Margin="0,0,7,0"/>
                                        <Button Content="{DynamicResource General_Import}" Style="{StaticResource SecondaryButton}" Click="BtnImportSettings_Click" Margin="0,0,7,0"/>
                                        <Button Content="{DynamicResource General_Reset}" Style="{StaticResource DangerButton}" Click="BtnResetSettings_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- About & System Information Section (Inside Settings) -->
                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,22,0,18"/>
                        <TextBlock Text="{DynamicResource Nav_About}" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,0,0,14"/>

                        <StackPanel x:Name="PanelAbout">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Width="64" Height="64" HorizontalAlignment="Left">
                                    <Border Background="{DynamicResource HeroInsetBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6"/>
                                    <Path Data="M12,26 L12,12 L26,12" Stroke="{DynamicResource ScanFrameBrush}" StrokeThickness="2" Width="48" Height="48" Stretch="Uniform"/>
                                    <Path Data="M36,22 L36,36 L22,36" Stroke="{DynamicResource ScanFrameBrush}" StrokeThickness="2" Width="48" Height="48" Stretch="Uniform"/>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource App_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource SegoeUIVariable}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                <TextBlock Text="{DynamicResource App_Tagline}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtAboutVersion" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,10,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                <TextBlock Text="{DynamicResource App_Creator}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11.5" Margin="0,4,0,0"/>
                                <TextBlock Text="{DynamicResource App_Copyright}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                <TextBlock Text="{DynamicResource About_Privacy}" Style="{StaticResource MutedText}" Margin="0,14,0,0" MaxWidth="400" HorizontalAlignment="Left"/>
                                <Border Style="{StaticResource InsetBorder}" Margin="0,14,0,0" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource About_Repo}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                        <Button Content="ZerroDevs/CryoUtils" Style="{StaticResource LinkButton}" Click="BtnRepo_Click" HorizontalAlignment="Left" Margin="0,3,0,0" FontFamily="{StaticResource CryoMono}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{DynamicResource About_License}" Style="{StaticResource MutedText}" Margin="0,10,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource About_Updates}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{DynamicResource About_UpdatesDesc}" Style="{StaticResource MutedText}" Margin="0,5,0,8"/>
                                        <CheckBox x:Name="ChkAutoUpdates" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource About_Automatic}" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <CheckBox x:Name="ChkSaveRollback" Style="{StaticResource CryoCheckBox}" Content="{DynamicResource About_Rollback}" Margin="0,9,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <TextBlock Text="{DynamicResource About_RollbackDesc}" Style="{StaticResource MutedText}" Margin="22,3,0,0"/>

                                        <TextBlock x:Name="TxtUpdateStatus" Text="{DynamicResource About_Never}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,2" AutomationProperties.LiveSetting="Polite"/>
                                        <TextBlock x:Name="TxtLastChecked" Text="{DynamicResource About_Never}" Style="{StaticResource MutedText}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                        <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderStrongBrush}" BorderThickness="0"/>
                                        <Border x:Name="UpdateNotesPanel" Style="{StaticResource InsetBorder}" Margin="0,8,0,0" Visibility="Collapsed" MaxHeight="120">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="TxtUpdateNotes" Style="{StaticResource MutedText}"/>
                                            </ScrollViewer>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="BtnCheckUpdates" Content="{DynamicResource About_Check}" Style="{StaticResource SecondaryButton}" Click="BtnCheckUpdates_Click" Margin="0,0,7,0"/>
                                            <Button x:Name="BtnDownloadUpdate" Content="{DynamicResource About_Download}" Style="{StaticResource PrimaryButton}" Click="BtnDownloadUpdate_Click" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource About_Restore}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="TxtRollbackStatus" Text="{DynamicResource About_NoBackup}" Style="{StaticResource MutedText}" Margin="0,6,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnRestore" Content="{DynamicResource About_Restore}" Style="{StaticResource SecondaryButton}" Click="BtnRestore_Click" IsEnabled="False" Margin="0,0,7,0"/>
                                            <Button x:Name="BtnDeleteBackup" Content="{DynamicResource About_DeleteBackup}" Style="{StaticResource DangerButton}" Click="BtnDeleteBackup_Click" IsEnabled="False"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Row 2: Status bar -->
            <Grid Grid.Row="2" Margin="22,0,22,0">
                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Top"/>
                <TextBlock x:Name="TxtStatusBar"
                           Text="{DynamicResource About_Privacy}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtStatusVersion"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FlowDirection="LeftToRight"/>
            </Grid>
        </Grid>
    </Border>
</Window>
