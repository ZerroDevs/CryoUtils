<Window x:Class="CryoUtils.Views.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Editor_Title}"
        Width="1120" Height="760"
        MinWidth="760" MinHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="{StaticResource SegoeUIVariableText}">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="{DynamicResource Editor_Title}" Foreground="{DynamicResource TextTitleBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtFile" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" Margin="12,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <Button Style="{StaticResource TitleActionBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Click="BtnClose_Click" ToolTip="{DynamicResource Common_Close}" AutomationProperties.Name="{DynamicResource Common_Close}">
                        <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="10,7">
                <WrapPanel>
                    <Button Content="{DynamicResource Editor_Open}" Style="{StaticResource SecondaryButton}" Click="BtnOpen_Click" Margin="0,0,5,0"/>
                    <Button Content="{DynamicResource Editor_Save}" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click" Margin="0,0,5,0"/>
                    <Button Content="{DynamicResource Editor_Copy}" Style="{StaticResource SecondaryButton}" Click="BtnCopy_Click" Margin="0,0,5,0"/>
                    <Button Content="{DynamicResource Editor_Convert}" Style="{StaticResource SecondaryButton}" Click="BtnConvert_Click" Margin="0,0,12,0"/>
                    <Button Content="{DynamicResource Editor_RotateLeft}" Style="{StaticResource SecondaryButton}" Click="BtnRotateLeft_Click" Margin="0,0,5,0"/>
                    <Button Content="{DynamicResource Editor_RotateRight}" Style="{StaticResource SecondaryButton}" Click="BtnRotateRight_Click" Margin="0,0,5,0"/>
                    <Button Content="{DynamicResource Editor_Resize}" Style="{StaticResource SecondaryButton}" Click="BtnResize_Click" Margin="0,0,5,0"/>
                    <Button x:Name="BtnCrop" Content="{DynamicResource Editor_Crop}" Style="{StaticResource SecondaryButton}" Click="BtnCrop_Click" Margin="0,0,5,0"/>
                    <Button Content="{DynamicResource Editor_ApplyCrop}" Style="{StaticResource SecondaryButton}" Click="BtnApplyCrop_Click" Margin="0,0,12,0"/>
                    <Button x:Name="BtnUndo" Content="{DynamicResource Editor_Undo}" Style="{StaticResource SecondaryButton}" Click="BtnUndo_Click" Margin="0,0,4,0"/>
                    <Button x:Name="BtnRedo" Content="{DynamicResource Capture_ToolRedo}" Style="{StaticResource SecondaryButton}" Click="BtnRedo_Click" Margin="0,0,10,0"/>
                    <Button x:Name="BtnPen" Tag="Pen" Content="{DynamicResource Editor_Pen}" Style="{StaticResource SecondaryButton}" Click="Tool_Click" Margin="0,0,4,0" ToolTip="Pen (1 / P)"/>
                    <Button x:Name="BtnArrow" Tag="Arrow" Content="{DynamicResource Editor_Arrow}" Style="{StaticResource SecondaryButton}" Click="Tool_Click" Margin="0,0,4,0" ToolTip="Arrow (2 / A)"/>
                    <Button x:Name="BtnBox" Tag="Box" Content="{DynamicResource Editor_Box}" Style="{StaticResource SecondaryButton}" Click="Tool_Click" Margin="0,0,4,0" ToolTip="Rectangle (3 / R)"/>
                    <Button x:Name="BtnRedact" Tag="Redact" Content="{DynamicResource Editor_Redact}" Style="{StaticResource SecondaryButton}" Click="Tool_Click" Margin="0,0,4,0" ToolTip="Redact (4 / K)"/>
                    <Button x:Name="BtnText" Tag="Text" Content="{DynamicResource Editor_Text}" Style="{StaticResource SecondaryButton}" Click="Tool_Click" Margin="0,0,10,0" ToolTip="Text (5 / T)"/>
                    <Button x:Name="BtnColor" Style="{StaticResource SecondaryButton}" Padding="5,3" Margin="0,0,6,0" Click="BtnColor_Click" ToolTip="{DynamicResource Capture_Color}" AutomationProperties.Name="{DynamicResource Capture_Color}">
                        <Border x:Name="ColorSwatch" Width="16" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Background="#E5534B"/>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Content="-" Width="24" Padding="0" Margin="0,0,3,0" Click="BtnThickDown_Click" ToolTip="Decrease stroke"/>
                    <Border Style="{StaticResource InsetBorder}" Padding="7,3" Margin="0,0,3,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtThickness" Text="3 px" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="11" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    </Border>
                    <Button Style="{StaticResource SecondaryButton}" Content="+" Width="24" Padding="0" Click="BtnThickUp_Click" ToolTip="Increase stroke"/>
                </WrapPanel>
            </Border>

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#0B0E10" PreviewMouseWheel="CanvasHost_PreviewMouseWheel">
                <Grid x:Name="CanvasHost" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#0B0E10">
                    <Image x:Name="PreviewImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Canvas x:Name="InkCanvas" Background="Transparent" ClipToBounds="True"
                            MouseLeftButtonDown="InkCanvas_MouseLeftButtonDown"
                            MouseMove="InkCanvas_MouseMove"
                            MouseLeftButtonUp="InkCanvas_MouseLeftButtonUp"/>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="{DynamicResource Editor_Hint}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtDimensions" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource CryoMono}" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
