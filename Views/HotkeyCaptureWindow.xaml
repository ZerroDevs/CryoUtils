<Window x:Class="CryoUtils.Views.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Hotkey_DialogTitle}"
        Width="440" Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SegoeUIVariableText}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Image Source="pack://application:,,,/Images/CryoUtils-Icon.png"
                           Width="16" Height="16"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource Hotkey_DialogTitle}"
                               Foreground="{DynamicResource TextTitleBrush}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="18,12,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource Hotkey_DialogHint}" Style="{StaticResource MutedText}"/>

                <Border Grid.Row="1" Background="{DynamicResource InsetBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="2" Margin="0,12,0,12" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtShortcut" Text="{DynamicResource Hotkeys_Press}" Foreground="{DynamicResource AccentTextBrush}" FontFamily="{StaticResource CryoMono}" FontSize="18" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                        <TextBlock x:Name="TxtError" Text="" Foreground="{DynamicResource DangerTextBrush}" FontSize="10.5" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Common_Cancel}" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSave" Content="{DynamicResource Common_Save}" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
